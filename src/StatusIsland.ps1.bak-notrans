}

# 上下翻页
$script:ticker = @{ all = @('正在读取状态…'); idx = 0; sys = @('正在读取状态…'); sysIdx = 0; hold = 0; flipping = $false; progress = 0.0 }

function Draw-Ticker($g, [string]$which, [int]$x, [int]$y, [int]$w, [int]$h, [System.Drawing.Color]$color) {
  $tk = $script:ticker
  $pages = $tk.all
  $cur = $tk.idx
  if ($which -eq 'sys') { $pages = $tk.sys; $cur = $tk.sysIdx }
  if (-not $pages -or $pages.Count -eq 0) { return }

  $st = $g.Save()
  $g.SetClip((New-Object System.Drawing.Rectangle($x, $y, $w, $h)))
  $sf = New-Object System.Drawing.StringFormat
  $sf.FormatFlags = [System.Drawing.StringFormatFlags]::NoWrap
  $mh = $g.MeasureString($pages[$cur], $F_Page).Height
  $ty = $y + [int](($h - $mh) / 2)
  $br = New-Object System.Drawing.SolidBrush($color)

  if (-not $tk.flipping -or $pages.Count -lt 2) {
    $g.DrawString($pages[$cur], $F_Page, $br, [single]$x, [single]$ty, $sf)
  } else {
    $slide = [single]($tk.progress * $h)
    $nxt = ($cur + 1) % $pages.Count
    $g.DrawString($pages[$cur], $F_Page, $br, [single]$x, [single]($ty - $slide), $sf)
    $g.DrawString($pages[$nxt], $F_Page, $br, [single]$x, [single]($ty + $h - $slide), $sf)
  }

  $br.Dispose()
  $sf.Dispose()
  $g.Restore($st)
}
$form.Add_Paint({
    param($sender, $e)
    $g = $e.Graphics
    $g.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
    $g.TextRenderingHint = [System.Drawing.Text.TextRenderingHint]::ClearTypeGridFit

    $w = [int]$script:size.w
    $h = [int]$script:size.h
    $frac = 0.0
    if (($H_E - $H_C) -gt 0) { $frac = ([double]$h - $H_C) / ($H_E - $H_C) }
    if ($frac -lt 0) { $frac = 0 }
    if ($frac -gt 1) { $frac = 1 }

    $v = $script:view

    $bg = New-Object System.Drawing.SolidBrush($C_Back)
    $g.FillRectangle($bg, 0, 0, $w, $h)
    $bg.Dispose()

    $rEdge = (20.0 * (1 - $frac)) + (12.0 * $frac)
    $maxR = [math]::Min($w, $h) / 2
    if ($rEdge -gt $maxR) { $rEdge = $maxR }
    $edge = New-RoundedPath 0 0 $w $h $rEdge
    $pen = New-Object System.Drawing.Pen($C_Line, 1)
    $g.DrawPath($pen, $edge)
    $pen.Dispose()
    $edge.Dispose()

    if ($script:animating) { return }
    if ($frac -lt 0.45) {
      # ---------- 胶囊态（两行：上=系统指标翻页，下=Codex/DSH 常亮） ----------
      $lineH = 20
      $accent = New-RoundedPath 9 11 3 32 1.5
      $ab = New-Object System.Drawing.SolidBrush($v.pillC)
      $g.FillPath($ab, $accent)
      $ab.Dispose()
      $accent.Dispose()
      Draw-Ticker $g 'sys' 18 4 ($w - 30) $lineH $C_Text

      $y2 = 28
      $cx2 = 18
      $isFirst = $true
      foreach ($chip in $v.chips) {
        if (-not $isFirst) {
          [System.Windows.Forms.TextRenderer]::DrawText($g, '·', $F_Small, (New-Object System.Drawing.Point($cx2, $y2)), $C_Faint)
          $cx2 = $cx2 + 12
        }
        $cc = $C_Dim
        if ($chip.busy) { $cc = $C_Warn }
        $txt = ('{0} {1}' -f $chip.t, $chip.state)
        if ($chip.t -eq '网易云') {
          $txt = '♪ 网易云'
          if ($chip.title) {
            $tt = [string]$chip.title
            if ($tt.Length -gt 13) { $tt = $tt.Substring(0, 13) + '…' }
            $txt = '♪ ' + $tt
          }
        }
        $tw = [System.Windows.Forms.TextRenderer]::MeasureText($txt, $F_Small).Width
        if (($cx2 + $tw) -gt ($w - 12)) { break }
        [System.Windows.Forms.TextRenderer]::DrawText($g, $txt, $F_Small, (New-Object System.Drawing.Point($cx2, $y2)), $cc)
        $cx2 = $cx2 + $tw + 10
        $isFirst = $false
      }
      return
    }
    # ---------- 展开态（右侧对齐，向左摊开） ----------
    $g.TranslateTransform(($w - $W_E), 0)

    $dotB = New-Object System.Drawing.SolidBrush($v.pillC)
    $g.FillEllipse($dotB, $PadX, 18, 8, 8)
    $dotB.Dispose()
    [System.Windows.Forms.TextRenderer]::DrawText($g, '状态台', $F_Title, (New-Object System.Drawing.Point(($PadX + 15), 10)), $C_Title)

    $sz = [System.Windows.Forms.TextRenderer]::MeasureText($v.pill, $F_Pill)
    $pillW = $sz.Width + 20
    $pillH = 20
    $pillX = $W_E - $PadX - $pillW
    $pillPath = New-RoundedPath $pillX 9 $pillW $pillH 10
    $pillFill = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(46, $v.pillC.R, $v.pillC.G, $v.pillC.B))
    $g.FillPath($pillFill, $pillPath)
    $pillFill.Dispose()
    $pillPath.Dispose()
    [System.Windows.Forms.TextRenderer]::DrawText($g, $v.pill, $F_Pill, (New-Object System.Drawing.Rectangle($pillX, 13, $pillW, $pillH)), $v.pillC, [System.Windows.Forms.TextFormatFlags]::HorizontalCenter)

    [System.Windows.Forms.TextRenderer]::DrawText($g, $v.sub, $F_Sub, (New-Object System.Drawing.Point($PadX, 36)), $C_Faint)

    $pen2 = New-Object System.Drawing.Pen($C_Line, 1)
    $g.DrawLine($pen2, $PadX, 56, ($W_E - $PadX), 56)

    $y = 64
    foreach ($row in $v.rows) {
      [System.Windows.Forms.TextRenderer]::DrawText($g, $row.l, $F_Row, (New-Object System.Drawing.Point($PadX, $y)), $C_Label)
      $vs = [System.Windows.Forms.TextRenderer]::MeasureText($row.v, $F_Val)
      $vx = $W_E - $PadX - $vs.Width
      [System.Windows.Forms.TextRenderer]::DrawText($g, $row.v, $F_Val, (New-Object System.Drawing.Point($vx, $y)), $row.c)
      $rb = New-Object System.Drawing.SolidBrush($row.c)
      $g.FillEllipse($rb, ($vx - 15), ($y + 8), 6, 6)
      $rb.Dispose()
      $y += 22
    }

    $g.DrawLine($pen2, $PadX, 128, ($W_E - $PadX), 128)

    $y = 136
    $barX = 84
    $barW = $W_E - $PadX - 62 - $barX
    foreach ($mt in $v.metrics) {
      [System.Windows.Forms.TextRenderer]::DrawText($g, $mt.l, $F_Small, (New-Object System.Drawing.Point($PadX, ($y - 1))), $C_Label)
      $track = New-RoundedPath $barX ($y + 6) $barW 7 3
      $tb = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(46, 255, 255, 255))
      $g.FillPath($tb, $track)
      $tb.Dispose()
      $track.Dispose()
      $ratio = [math]::Min(1.0, [math]::Max(0.0, $mt.pct / 100.0))
      $fw = [int]($barW * $ratio)
      if ($fw -gt 3) {
        $fill = New-RoundedPath $barX ($y + 6) $fw 7 3
        $fb = New-Object System.Drawing.SolidBrush($mt.c)
        $g.FillPath($fb, $fill)
        $fb.Dispose()
        $fill.Dispose()
      }
      $ms = [System.Windows.Forms.TextRenderer]::MeasureText($mt.v, $F_Small)
      [System.Windows.Forms.TextRenderer]::DrawText($g, $mt.v, $F_Small, (New-Object System.Drawing.Point((($W_E - $PadX) - $ms.Width), ($y - 1))), $mt.c)
      $y += 23
    }

    $g.DrawLine($pen2, $PadX, 224, ($W_E - $PadX), 224)

    $chipCount = $v.chips.Count
    if ($chipCount -lt 1) { $chipCount = 1 }
    $chipW = [int](($W_E - 2 * $PadX - 2 * 8 * ($chipCount - 1)) / $chipCount)
    $cx = $PadX
    if ($v.chips.Count -eq 0) {
      [System.Windows.Forms.TextRenderer]::DrawText($g, 'Codex / DSH 未运行', $F_Small, (New-Object System.Drawing.Point($PadX, 233)), $C_Faint)
    }
    foreach ($chip in $v.chips) {
      $cColor = $C_Ok
      if ($chip.busy) { $cColor = $C_Warn }
      $cPath = New-RoundedPath $cx 231 $chipW 22 7
      $cb = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(34, $cColor.R, $cColor.G, $cColor.B))
      $g.FillPath($cb, $cPath)
      $cb.Dispose()
      $cPath.Dispose()
      $db = New-Object System.Drawing.SolidBrush($cColor)
      $g.FillEllipse($db, ($cx + 10), 239, 5, 5)
      $db.Dispose()
      $label = $chip.t
      if ($chipW -ge 118) { $label = ('{0} {1}' -f $chip.t, $chip.state) }
      [System.Windows.Forms.TextRenderer]::DrawText($g, $label, $F_Small, (New-Object System.Drawing.Point(($cx + 20), 233)), $cColor)
      $cx += $chipW + 8
    }

    $g.DrawLine($pen2, $PadX, 258, ($W_E - $PadX), 258)
    $pen2.Dispose()

    Draw-Ticker $g 'all' $PadX 262 ($W_E - 2 * $PadX) 18 $C_Text
    $g.ResetTransform()
  })

$onDown = {
  param($sender, $e)
  if ($e.Button -eq [System.Windows.Forms.MouseButtons]::Left) {
    $script:dragging = $true
    $script:dragPt = $e.Location
  }
}
$onMove = {
  param($sender, $e)
  if ($script:dragging) {
    $p2 = $form.PointToScreen($e.Location)
    $script:top = $p2.Y - $script:dragPt.Y
    $script:anchorRight = $p2.X - $script:dragPt.X + [int]$script:size.w
    Set-Geometry
  }
}
$onUp = { param($sender, $e) $script:dragging = $false }
$form.Add_MouseDown($onDown)
$form.Add_MouseMove($onMove)
$form.Add_MouseUp($onUp)

$script:workerProc = $null
function Start-Worker {
  $old = Get-Content $PidFile -ErrorAction SilentlyContinue
  if ($old) { Stop-Process -Id ([int]$old) -Force -ErrorAction SilentlyContinue }
  Remove-Item $Status -Force -ErrorAction SilentlyContinue
  if (Test-Path $Launcher) {
    $script:workerProc = Start-Process -FilePath (Join-Path $env:SystemRoot 'System32\wscript.exe') -ArgumentList @("`"$Launcher`"", '-Worker') -WindowStyle Hidden -PassThru
  } else {
    $psExe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    $script:workerProc = Start-Process -FilePath $psExe -ArgumentList @('-NoProfile', '-WindowStyle', 'Hidden', '-ExecutionPolicy', 'Bypass', '-File', "`"$PSCommandPath`"", '-Worker') -WindowStyle Hidden -PassThru
  }
  Write-Log ("ui start worker " + $script:workerProc.Id)
}

$menu = New-Object System.Windows.Forms.ContextMenuStrip
$miRefresh = $menu.Items.Add('刷新')
$miRefresh.Add_Click({ Start-Worker })
$miTunnel = $menu.Items.Add('重连 Mac 隧道')
$miTunnel.Add_Click({
    try {
      $psExe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
      Start-Process -FilePath $psExe -ArgumentList @('-NoProfile', '-WindowStyle', 'Hidden', '-ExecutionPolicy', 'Bypass', '-File', $Cfg.tunnelStartScript) -WindowStyle Hidden | Out-Null
      Write-Log 'ui: requested tunnel restart'
      Start-Sleep -Seconds 6
      Start-Worker
    } catch { }
  })
$miOpen = $menu.Items.Add('打开 Clash Verge')
$miOpen.Add_Click({ if ($Cfg.clashExe) { Start-Process $Cfg.clashExe } })
$menu.Items.Add('-') | Out-Null
$miExit = $menu.Items.Add('退出')
$miExit.Add_Click({ $form.Close() })
$form.ContextMenuStrip = $menu

# ---- UI 侧快速忙碌采样（1.2s 粒度，比 worker 的 6~11s 灵敏得多）----
$script:cpuPrev = @{}
$script:lastActive = @{ codex = $null; dsh = $null }
$script:busyTick = 0
$script:busyCacheCodex = @{ busy = $false; last = $null }
$script:busyCacheDsh = @{ busy = $false; last = $null }

function Update-BusyState($ProcIds, [string]$Key) {
  $now = Get-Date
  $sum = 0.0
  $n = 0
  foreach ($procId in @($ProcIds)) {
    if (-not $procId) { continue }
    $pr = Get-Process -Id ([int]$procId) -ErrorAction SilentlyContinue
    if ($pr) { $sum += [double]$pr.CPU; $n++ }
  }
  $prev = $script:cpuPrev[$Key]
  $busyNow = $false
  if ($prev -and $n -gt 0) {
    $wall = ($now - $prev.ts).TotalSeconds
    if ($wall -gt 0.3) {
      $delta = $sum - $prev.cpu
      if ($delta -lt 0) { $delta = 0 }
      $thr = [double]$Cfg.busyThreshold
      if ($thr -le 0) { $thr = 0.05 }
      if (($delta / $wall) -gt $thr) { $busyNow = $true }
    }
  }
  $script:cpuPrev[$Key] = @{ cpu = $sum; ts = $now }
  if ($busyNow) { $script:lastActive[$Key] = $now }
  $last = $script:lastActive[$Key]
  $busy = $false
  if ($last -and ($now - $last).TotalSeconds -le 6) { $busy = $true }
  return @{ busy = $busy; last = $last }
}
$timer = New-Object System.Windows.Forms.Timer
$timer.Interval = 1200
$timer.Add_Tick({
    $s = $null
    try {
      if (Test-Path $Status) {
        $raw = [IO.File]::ReadAllText($Status, $Utf8NoBom)
        if (-not [string]::IsNullOrWhiteSpace($raw)) { $s = $raw | ConvertFrom-Json }
      }
    } catch { $s = $null }

    $stale = $true
    if ($s) {
      try {
        $age = (Get-Date) - [datetime]$s.ts
        if ($age.TotalSeconds -lt ($IntervalSec * 4 + 12)) { $stale = $false }
      } catch { $stale = $true }
    }

    $wdOk = $true
    if ($WatchdogLock) {
      try {
        $probe = [IO.File]::Open($WatchdogLock, 'Open', 'ReadWrite', 'None')
        $probe.Dispose()
        $wdOk = $false
      } catch { }
    }

    if ($stale) {
      $script:view.pill = '采集中'; $script:view.pillC = $C_Faint
      $script:view.sub = '正在读取状态…'
      $script:ticker.all = @('正在读取状态…'); $script:ticker.sys = @('正在读取状态…')
      return
    }

    $secs = [int]((Get-Date) - [datetime]$s.ts).TotalSeconds

    try { $busyCodex = Update-BusyState $s.codexPids 'codex' } catch { $busyCodex = @{ busy = $false; last = $null } }
    try { $busyDsh = Update-BusyState $s.dshPid 'dsh' } catch { $busyDsh = @{ busy = $false; last = $null } }
    $s.codexBusy = [bool]$busyCodex.busy
    $s.dshBusy = [bool]$busyDsh.busy
    if ($busyCodex.last) { $s.codexLast = $busyCodex.last.ToString('o') }
    if ($busyDsh.last) { $s.dshLast = $busyDsh.last.ToString('o') }
    $wdText = '看门狗 ✗'
    if ($wdOk) { $wdText = '看门狗 ✓' }

    if ($s.tsState -eq 'timeout') { $macV = 'Tailscale 无响应'; $macC = $C_Bad; $macOn = $false }
    elseif ($s.tsState -eq 'Stopped' -or $s.tsState -eq 'missing') {
      $macV = 'Tailscale 已停止'
      if ($s.tsState -eq 'missing') { $macV = '未安装 Tailscale' }
      $macC = $C_Bad; $macOn = $false
    }
    elseif ($s.macKnown -and $s.macOnline) { $macV = '在线'; $macC = $C_Ok; $macOn = $true }
    elseif ($s.macKnown) {
      $ago = ''
      if ($s.macLastSeen) {
        try {
          $tt = ([datetime]$s.macLastSeen).ToUniversalTime()
          $mins = [int](([datetime]::UtcNow - $tt).TotalMinutes)
          if ($mins -ge 0) { $ago = " · ${mins}分钟前" }
        } catch { }
      }
      $macV = "离线$ago"; $macC = $C_Bad; $macOn = $false
    }
    else { $macV = '未知'; $macC = $C_Faint; $macOn = $false }

    if ($s.socksOk) { $socksV = '通 · 204'; $socksC = $C_Ok }
    elseif ($s.portUp) { $socksV = '端口在听但不通'; $socksC = $C_Warn }
    else { $socksV = '无隧道'; $socksC = $C_Faint }

    $route = ([string]$s.route) -replace '^[^\p{L}\p{N}]+', ''
    $viaMac = $false
    if ($route -like ('*' + $Cfg.clashMacProxyName + '*')) { $viaMac = $true }
    if (-not $s.routeOk) { $routeV = '未知'; $routeC = $C_Faint }
    elseif ($viaMac) { $routeV = '经 Mac'; $routeC = $C_Ok }
    elseif ($route -eq 'DIRECT') { $routeV = '直连'; $routeC = $C_Warn }
    else { $routeV = "机场 · $route"; $routeC = $C_Warn }

    if ($s.socksOk -and $viaMac) { $pill = '正常'; $pillC = $C_Ok }
    elseif ($s.socksOk) { $pill = '降级'; $pillC = $C_Warn }
    elseif ($s.portUp) { $pill = '异常'; $pillC = $C_Bad }
    else { $pill = '离线'; $pillC = $C_Bad }

    $cpu = [int]$s.cpu; if ($cpu -lt 0) { $cpu = 0 }
    $mem = [int]$s.mem; if ($mem -lt 0) { $mem = 0 }
    $dC = [int]$s.diskC; if ($dC -lt 0) { $dC = 0 }
    $dD = [int]$s.diskD; if ($dD -lt 0) { $dD = 0 }
    $gu = [int]$s.gpuUtil; if ($gu -lt 0) { $gu = 0 }

    $gpuV = "$gu%"
    if ($s.gpuTotalMB -gt 0) { $gpuV = ('{0}%  {1:N1}/{2:N1}G' -f $gu, ($s.gpuUsedMB / 1024), ($s.gpuTotalMB / 1024)) }

    $script:view.pill = $pill; $script:view.pillC = $pillC
    $script:view.sub = "{0}s 前更新 · {1}" -f $secs, $wdText
    $script:view.rows = @(
      @{ l = 'Mac 主机'; v = $macV; c = $macC },
      @{ l = '隧道实测'; v = $socksV; c = $socksC },
      @{ l = '出口线路'; v = $routeV; c = $routeC }
    )
    $script:view.metrics = @(
      @{ l = 'CPU'; v = "$cpu%"; pct = $cpu; c = (Get-BarColor $cpu) },
      @{ l = '内存'; v = "$mem%"; pct = $mem; c = (Get-BarColor $mem) },
      @{ l = '磁盘 D'; v = "$dD%"; pct = $dD; c = (Get-BarColor $dD) },
      @{ l = 'GPU'; v = $gpuV; pct = $gu; c = (Get-BarColor $gu) }
    )
    $chips = @()
    if ($s.codexRun) {
      $st = '空闲'; if ($s.codexBusy) { $st = '工作中' }
      $chips += @{ t = 'Codex'; busy = [bool]$s.codexBusy; state = $st }
    }
    if ($s.dshUp) {
      $st = '空闲'; if ($s.dshBusy) { $st = '工作中' }
      $chips += @{ t = 'DSH'; busy = [bool]$s.dshBusy; state = $st }
    }
    if ($s.neteaseUp) {
      $ncmBusy = $false; $ncmState = '运行中'; $ncmTitle = ''
      if ($s.neteaseTitle) { $ncmBusy = $true; $ncmState = '在播'; $ncmTitle = [string]$s.neteaseTitle }
      $chips += @{ t = '网易云'; busy = $ncmBusy; state = $ncmState; title = $ncmTitle }
    }
    $script:view.chips = $chips
    $codexTxt = 'Codex 未开'; if ($s.codexRun) { $codexTxt = 'Codex 运行中' }
    $dshTxt = 'DSH 未启动'; if ($s.dshUp) { $dshTxt = ('DSH {0} 在听' -f $Cfg.dshPort) }
    $ncmTxt = '网易云 未运行'; if ($s.neteaseUp) { $ncmTxt = '网易云 运行中' }
    if ($s.neteaseTitle) { $ncmTxt = '网易云 ' + $s.neteaseTitle }
    $codexDone = '未运行'; if ($s.codexRun) { $codexDone = '空闲' }
    if ($s.codexBusy) { $codexDone = '工作中' }
    if ($s.codexRun -and $s.codexLast) { try { $codexDone = $codexDone + ' · 上次 ' + ([datetime]$s.codexLast).ToString('HH:mm') } catch { } }
    $dshDone = '未运行'; if ($s.dshUp) { $dshDone = '空闲' }
    if ($s.dshBusy) { $dshDone = '工作中' }
    if ($s.dshUp -and $s.dshLast) { try { $dshDone = $dshDone + ' · 上次 ' + ([datetime]$s.dshLast).ToString('HH:mm') } catch { } }
    $hint = '机场兜底中（Mac 不可用）'
    if (-not $s.routeOk) { $hint = '读取不到 Clash 状态' }
    elseif ($s.socksOk -and -not $viaMac) { $hint = '隧道已通，可切回 Mac 省流量' }
    elseif ($s.socksOk -and $viaMac) { $hint = '一切正常，ChatGPT 走 Mac' }
    elseif ($viaMac -and -not $s.socksOk) { $hint = 'Mac 线路不通，建议切机场' }
    elseif (-not $s.socksOk -and $macOn) { $hint = 'Mac 在线，但隧道未建立' }

    $script:ticker.sys = @(
      ("CPU {0}%   ·   内存 {1}%" -f $cpu, $mem),
      ("磁盘 C {0}%   D {1}%" -f $dC, $dD),
      ("GPU {0}" -f $gpuV)
    )
    $script:ticker.all = @(
      ("CPU {0}%   ·   内存 {1}%" -f $cpu, $mem),
      ("磁盘 C {0}%   D {1}%" -f $dC, $dD),
      ("GPU {0}" -f $gpuV),
      ("{0}   ·   {1}" -f $codexTxt, $dshTxt),
      ("{0}   ·   {1}" -f $ncmTxt, $wdText),
      ("隧道 {0}   ·   出口 {1}" -f $pill, $routeV),
      ("Codex {0}   ·   DSH {1}" -f $codexDone, $dshDone),
      ("{0}s 前更新   ·   → {1}" -f $secs, $hint)
    )
  })

$script:tickerHold = 0
$anim = New-Object System.Windows.Forms.Timer
$anim.Interval = 80
$anim.Add_Tick({
    $tgtW = $W_C; $tgtH = $H_C
    if ($script:mode -eq 'expanded') { $tgtW = $W_E; $tgtH = $H_E }
    $curW = [int]$script:size.w
    $curH = [int]$script:size.h
    $changed = $false
    if ($curW -ne $tgtW) {
      $step = [int]([math]::Ceiling([math]::Abs($tgtW - $curW) / 3))
      if ($step -lt 8) { $step = 8 }
      if ($tgtW -gt $curW) { $curW = $curW + $step } else { $curW = $curW - $step }
      if ([math]::Abs($tgtW - $curW) -lt 8) { $curW = $tgtW }
      $changed = $true
    }
    if ($curH -ne $tgtH) {
      $stepH = [int]([math]::Ceiling([math]::Abs($tgtH - $curH) / 3))
      if ($stepH -lt 8) { $stepH = 8 }
      if ($tgtH -gt $curH) { $curH = $curH + $stepH } else { $curH = $curH - $stepH }
      if ([math]::Abs($tgtH - $curH) -lt 8) { $curH = $tgtH }
      $changed = $true
    }
    $script:size.w = $curW
    $script:size.h = $curH
    if ($changed) {
      Set-Geometry
      $form.Invalidate()
    }
    $wasAnimating = $script:animating
    $script:animating = $changed
    if (-not $changed -and $wasAnimating) { Set-Geometry }
    if ($changed) {
      Set-Geometry
      $form.Invalidate()
    }

    # 翻页动画
    $tk = $script:ticker
    $script:tickerHold += 30
    if ($tk.flipping) {
      $tk.progress += 0.34
      if ($tk.progress -ge 1.0) {
        $tk.progress = 0.0
        $tk.flipping = $false
        $tk.idx = ($tk.idx + 1) % [math]::Max(1, $tk.all.Count)
        $tk.sysIdx = ($tk.sysIdx + 1) % [math]::Max(1, $tk.sys.Count)
        $script:tickerHold = 0
      }
      $form.Invalidate()
    } elseif ($script:tickerHold -ge 3200 -and $tk.all.Count -gt 1) {
      $tk.flipping = $true
      $tk.progress = 0.0
      $form.Invalidate()
    }

    if (-not $script:dragging) {
      $inside = $form.Bounds.Contains([System.Windows.Forms.Cursor]::Position)
      if ($inside -and $script:mode -ne 'expanded') { $script:mode = 'expanded' }
      elseif (-not $inside -and $script:mode -ne 'compact') { $script:mode = 'compact'
$script:animating = $false }
    }
  })

Set-Geometry

$form.Add_Shown({
    Start-Worker
    $timer.Start()
    $anim.Start()
  })
$form.Add_FormClosed({
    $timer.Stop()
    $anim.Stop()
    try { if ($script:workerProc -and -not $script:workerProc.HasExited) { $script:workerProc.Kill() } } catch { }
    $wp = Get-Content $PidFile -ErrorAction SilentlyContinue
    if ($wp) { Stop-Process -Id ([int]$wp) -Force -ErrorAction SilentlyContinue }
    Write-Log 'ui closed'
  })

[void]$form.ShowDialog()
