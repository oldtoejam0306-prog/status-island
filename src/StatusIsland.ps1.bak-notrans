param([switch]$Worker, [switch]$Once, [int]$IntervalSec = 6)
$ErrorActionPreference = 'SilentlyContinue'

# ===== 可配置项（同目录 config.json 可覆盖，键名一致） =====
$ConfigFile = Join-Path $PSScriptRoot 'config.json'
$Cfg = [ordered]@{
  macHost           = '100.64.0.1'                                  # Mac 的 Tailscale IP
  socksPort         = 1080                                            # 本机 SOCKS5 端口
  clashGroup        = '选择节点'                                       # Clash 中决定 ChatGPT 走向的 selector
  clashMacProxyName = 'SG-Mac-SOCKS5'                                 # 该 selector 指向 Mac 隧道时的代理名
  tailscaleExe      = 'C:\Program Files\Tailscale\tailscale.exe'
  nvidiaSmi         = 'C:\Windows\System32\nvidia-smi.exe'
  dshPort           = 3081
  codexProcess      = 'ChatGPT'
  neteaseProcess    = 'cloudmusic'
  watchdogLockPath  = ''                                              # 可选：看门狗锁文件，留空则不显示守护状态
  tunnelStartScript = ''                                              # 可选：右键“重连隧道”要执行的脚本
  clashExe          = 'clash-verge.exe'                                # 可选：右键打开 Clash Verge 的程序
  busyThreshold     = 0.06                                          # 判定「工作中」的 CPU 阈值（0.06 = 单核 6%）
}
if (Test-Path -LiteralPath $ConfigFile) {
  try {
    $rawCfg = Get-Content -LiteralPath $ConfigFile -Raw -Encoding UTF8 | ConvertFrom-Json
    foreach ($k in @($Cfg.Keys)) {
      if ($null -ne $rawCfg.$k -and "$($rawCfg.$k)" -ne '') { $Cfg[$k] = $rawCfg.$k }
    }
  } catch { }
}

$Root     = Join-Path $env:LOCALAPPDATA 'StatusIsland'
$Status   = Join-Path $Root 'status.json'
$PidFile  = Join-Path $Root 'worker.pid'
$Log      = Join-Path $Root 'widget.log'
$Launcher = Join-Path $Root 'launcher.vbs'
New-Item -ItemType Directory -Force -Path $Root | Out-Null

$TailscaleExe = $Cfg.tailscaleExe
$MacIp        = $Cfg.macHost
$ClashGroup   = $Cfg.clashGroup
$WatchdogLock = $Cfg.watchdogLockPath
$NvidiaSmi    = $Cfg.nvidiaSmi
$Utf8NoBom    = New-Object System.Text.UTF8Encoding($false)

function Write-Log([string]$m) {
  try {
    Add-Content -Path $Log -Value ((Get-Date -Format 'HH:mm:ss') + ' ' + $m) -Encoding UTF8
    if ((Get-Item $Log).Length -gt 200KB) { (Get-Content $Log -Tail 200) | Set-Content -Path $Log -Encoding UTF8 }
  } catch { }
}

function Test-TcpPort([int]$Port, [int]$TimeoutMs = 500) {
  $c = New-Object System.Net.Sockets.TcpClient
  try {
    $t = $c.ConnectAsync('127.0.0.1', $Port)
    if ($t.Wait($TimeoutMs) -and $c.Connected) { return $true }
    return $false
  } catch { return $false } finally { try { $c.Close() } catch { } }
}

function Invoke-Capture([string]$Exe, [string[]]$ArgList, [int]$TimeoutMs = 3000) {
  $tmpOut = [IO.Path]::GetTempFileName()
  $tmpErr = [IO.Path]::GetTempFileName()
  try {
    $p = Start-Process -FilePath $Exe -ArgumentList $ArgList -NoNewWindow -PassThru -RedirectStandardOutput $tmpOut -RedirectStandardError $tmpErr
    if (-not $p.WaitForExit($TimeoutMs)) { try { $p.Kill() } catch { }; return $null }
    return [IO.File]::ReadAllText($tmpOut)
  } catch { return $null } finally {
    Remove-Item $tmpOut, $tmpErr -Force -ErrorAction SilentlyContinue
  }
}

function Get-MacState {
  $x = [ordered]@{ known = $false; online = $false; lastSeen = $null; tsState = 'unknown' }
  if (-not (Test-Path $TailscaleExe)) { $x.tsState = 'missing'; return $x }
  $svc = Get-Service -Name 'Tailscale' -ErrorAction SilentlyContinue
  if ($null -eq $svc) { $x.tsState = 'missing'; return $x }
  if ($svc.Status -ne 'Running') { $x.tsState = 'Stopped'; return $x }
  $raw = Invoke-Capture $TailscaleExe @('status', '--json') 3500
  if ([string]::IsNullOrWhiteSpace($raw)) { $x.tsState = 'timeout'; return $x }
  try { $o = $raw | ConvertFrom-Json } catch { $x.tsState = 'timeout'; return $x }
  $x.tsState = [string]$o.BackendState
  if ($x.tsState -ne 'Running') { return $x }
  $node = $null
  if ($o.Self -and ($o.Self.TailscaleIPs -contains $MacIp)) { $node = $o.Self }
  if (-not $node -and $o.Peer) {
    foreach ($pp in $o.Peer.PSObject.Properties) {
      if ($pp.Value.TailscaleIPs -contains $MacIp) { $node = $pp.Value; break }
    }
  }
  if ($node) {
    $x.known = $true
    $x.online = [bool]$node.Online
    if ($node.LastSeen) { $x.lastSeen = $node.LastSeen }
  }
  return $x
}

function Test-SocksHttp([int]$TimeoutSec = 8) {
  $code = & curl.exe -s -o NUL --socks5-hostname 127.0.0.1:$($Cfg.socksPort) --max-time $TimeoutSec -w '%{http_code}' 'http://www.gstatic.com/generate_204' 2>$null
  return ([string]$code -eq '204')
}

function Get-ClashPipePath {
  $proc = Get-CimInstance Win32_Process -Filter "Name='verge-mihomo.exe'" | Select-Object -First 1
  if (-not $proc -or -not $proc.CommandLine) { return $null }
  $m = [regex]::Match($proc.CommandLine, '-ext-ctl-pipe\s+(\S+)')
  if ($m.Success) { return $m.Groups[1].Value.Trim('"') }
  return $null
}

function Invoke-PipeGet([string]$PipePath, [string]$Path) {
  if (-not $PipePath) { return $null }
  $server = '.'
  $pipeName = $PipePath
  if ($PipePath -match '^\\\\\.\\pipe\\(.+)$') { $pipeName = $Matches[1] }
  $client = New-Object System.IO.Pipes.NamedPipeClientStream($server, $pipeName, [System.IO.Pipes.PipeDirection]::InOut, [System.IO.Pipes.PipeOptions]::None)
  try {
    $client.Connect(1500)
    $req = "GET $Path HTTP/1.1`r`nHost: localhost`r`nConnection: close`r`n`r`n"
    $bytes = [Text.Encoding]::UTF8.GetBytes($req)
    $client.Write($bytes, 0, $bytes.Length)
    $client.Flush()
    $ms = New-Object System.IO.MemoryStream
    $buf = New-Object byte[] 32768
    while (($n = $client.Read($buf, 0, $buf.Length)) -gt 0) { $ms.Write($buf, 0, $n) }
    $raw = $ms.ToArray()
  } catch { return $null } finally { try { $client.Dispose() } catch { } }

  $hdrEnd = -1
  for ($i = 0; $i -lt $raw.Length - 3; $i++) {
    if ($raw[$i] -eq 13 -and $raw[$i + 1] -eq 10 -and $raw[$i + 2] -eq 13 -and $raw[$i + 3] -eq 10) { $hdrEnd = $i; break }
  }
  if ($hdrEnd -lt 0) { return $null }
  $hdr = [Text.Encoding]::ASCII.GetString($raw, 0, $hdrEnd)
  if ($hdr -notmatch '(?i)chunked') {
    return [Text.Encoding]::UTF8.GetString($raw, $hdrEnd + 4, $raw.Length - $hdrEnd - 4)
  }
  $out = New-Object System.IO.MemoryStream
  $pos = $hdrEnd + 4
  while ($pos -lt $raw.Length) {
    $nl = -1
    for ($i = $pos; $i -lt $raw.Length - 1; $i++) { if ($raw[$i] -eq 13 -and $raw[$i + 1] -eq 10) { $nl = $i; break } }
    if ($nl -lt 0) { break }
    $lenHex = ([Text.Encoding]::ASCII.GetString($raw, $pos, $nl - $pos) -split ';')[0].Trim()
    if ([string]::IsNullOrWhiteSpace($lenHex)) { break }
    try { $len = [Convert]::ToInt32($lenHex, 16) } catch { break }
    if ($len -eq 0) { break }
    $out.Write($raw, $nl + 2, $len)
    $pos = $nl + 2 + $len + 2
  }
  return [Text.Encoding]::UTF8.GetString($out.ToArray())
}

function Get-Route([string]$PipePath) {
  $enc = [uri]::EscapeDataString($ClashGroup)
  $json = Invoke-PipeGet $PipePath ("/proxies/" + $enc)
  if ([string]::IsNullOrWhiteSpace($json)) { return [ordered]@{ ok = $false; name = '' } }
  try { $o = $json | ConvertFrom-Json } catch { return [ordered]@{ ok = $false; name = '' } }
  if ($o.now) { return [ordered]@{ ok = $true; name = [string]$o.now } }
  return [ordered]@{ ok = $false; name = '' }
}

$script:busyPrev = @{}
$script:lastBusyCodex = $null
$script:lastBusyDsh = $null

function Get-BusyState([string]$Key, [int[]]$ProcIds, [double]$Threshold = 0.0) {
  if ($Threshold -le 0) { $Threshold = [double]$Cfg.busyThreshold }
  $now = Get-Date
  $sum = 0.0
  $n = 0
  foreach ($procId in @($ProcIds)) {
    if (-not $procId) { continue }
    $pr = Get-Process -Id ([int]$procId) -ErrorAction SilentlyContinue
    if ($pr) { $sum += [double]$pr.CPU; $n++ }
  }
  $prev = $script:busyPrev[$Key]
  $busy = $false
  if ($prev -and $n -gt 0) {
    $wall = ($now - $prev.ts).TotalSeconds
    if ($wall -gt 0.5) {
      $delta = $sum - $prev.cpu
      if ($delta -lt 0) { $delta = 0 }
      $busy = (($delta / $wall) -gt $Threshold)
    }
  }
  $script:busyPrev[$Key] = @{ cpu = $sum; ts = $now }
  return $busy
}

function Get-SystemMetrics {
  $m = [ordered]@{
    cpu = -1; mem = -1; memTotalGB = 0; memFreeGB = 0
    diskC = -1; diskD = -1
    gpuUtil = -1; gpuUsedMB = 0; gpuTotalMB = 0; gpuName = ''
    codexRun = $false; codexBusy = $false; codexLast = $null
    dshUp = $false; dshBusy = $false; dshLast = $null
    neteaseUp = $false; neteaseTitle = ''
    nvidia = $false
  }
  try {
    $c = (Get-CimInstance Win32_PerfFormattedData_PerfOS_Processor | Where-Object { $_.Name -eq '_Total' }).PercentProcessorTime
    if ($null -ne $c) { $m.cpu = [int]$c }
  } catch { }
  try {
    $os = Get-CimInstance Win32_OperatingSystem
    $m.memTotalGB = [math]::Round($os.TotalVisibleMemorySize / 1MB, 1)
    $m.memFreeGB = [math]::Round($os.FreePhysicalMemory / 1MB, 1)
    if ($os.TotalVisibleMemorySize -gt 0) {
      $m.mem = [int]((1 - ($os.FreePhysicalMemory / $os.TotalVisibleMemorySize)) * 100)
    }
  } catch { }
  try {
    foreach ($d in (Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3")) {
      $pct = [int]((1 - ($d.FreeSpace / $d.Size)) * 100)
      if ($d.DeviceID -eq 'C:') { $m.diskC = $pct }
      if ($d.DeviceID -eq 'D:') { $m.diskD = $pct }
    }
  } catch { }
  if (Test-Path $NvidiaSmi) {
    try {
      $line = (& $NvidiaSmi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits 2>$null) | Select-Object -First 1
      if ($line) {
        $pv = $line -split ','
        if ($pv.Count -ge 3) {
          $m.gpuUtil = [int]($pv[0].Trim())
          $m.gpuUsedMB = [int]($pv[1].Trim())
          $m.gpuTotalMB = [int]($pv[2].Trim())
          $m.nvidia = $true
        }
      }
    } catch { }
  }
  if (-not $m.nvidia) {
    try { $m.gpuName = (Get-CimInstance Win32_VideoController | Select-Object -First 1).Name } catch { }
  }

  # Codex：进程存在才算"开启"；CPU 增量判断忙碌；记录最近一次忙碌时刻（= 上次任务活动）
  $codexProcs = @(Get-Process $Cfg.codexProcess -ErrorAction SilentlyContinue)
  $m.codexRun = ($codexProcs.Count -gt 0)
  if ($m.codexRun) {
    $ids = @($codexProcs | ForEach-Object { [int]$_.Id })
    $m.codexBusy = Get-BusyState 'codex' $ids
    if ($m.codexBusy) { $script:lastBusyCodex = (Get-Date).ToString('o') }
  }
  $m.codexPids = @($codexProcs | ForEach-Object { [int]$_.Id })
  $m.codexLast = $script:lastBusyCodex

  # DSH：端口在听才算"开启"；用端口占用进程的 CPU 增量判断忙碌
  $dshConn = Get-NetTCPConnection -LocalPort $Cfg.dshPort -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1
  if ($dshConn) {
    $m.dshUp = $true
    $m.dshBusy = Get-BusyState 'dsh' @([int]$dshConn.OwningProcess)
    if ($m.dshBusy) { $script:lastBusyDsh = (Get-Date).ToString('o') }
  }
  $m.dshPid = 0
  if ($dshConn) { $m.dshPid = [int]$dshConn.OwningProcess }
  $m.dshLast = $script:lastBusyDsh

  try {
    $ncm = Get-Process $Cfg.neteaseProcess -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($ncm) { $m.neteaseUp = $true; $m.neteaseTitle = [string]$ncm.MainWindowTitle }
  } catch { }
  return $m
}
function Get-Snapshot {
  $mac = Get-MacState
  $port = Test-TcpPort $Cfg.socksPort 500
  $socks = $false
  if ($port) { $socks = Test-SocksHttp 8 }
  $pipe = Get-ClashPipePath
  $route = Get-Route $pipe
  $sys = Get-SystemMetrics
  return [ordered]@{
    ts          = (Get-Date).ToString('o')
    macKnown    = $mac.known
    macOnline   = $mac.online
    macLastSeen = $mac.lastSeen
    tsState     = [string]$mac.tsState
    portUp      = $port
    socksOk     = $socks
    routeOk     = $route.ok
    route       = $route.name
    clashPipe   = [bool]$pipe
    cpu         = $sys.cpu
    mem         = $sys.mem
    memTotalGB  = $sys.memTotalGB
    memFreeGB   = $sys.memFreeGB
    diskC       = $sys.diskC
    diskD       = $sys.diskD
    gpuUtil     = $sys.gpuUtil
    gpuUsedMB   = $sys.gpuUsedMB
    gpuTotalMB  = $sys.gpuTotalMB
    gpuName     = $sys.gpuName
    codexRun    = $sys.codexRun
    codexPids   = $sys.codexPids
    codexBusy   = $sys.codexBusy
    codexLast   = $sys.codexLast
    dshUp       = $sys.dshUp
    dshPid      = $sys.dshPid
    dshBusy     = $sys.dshBusy
    dshLast     = $sys.dshLast
    neteaseUp   = $sys.neteaseUp
    neteaseTitle= $sys.neteaseTitle
  }
}

# ---------------- worker ----------------
if ($Worker) {
  $PID | Set-Content -Path $PidFile -Encoding ASCII
  Write-Log "worker start pid=$PID"
  $tick = 0
  $cacheMac = $null
  $cacheRoute = $null
  try {
    while ($true) {
      if (($tick % 3) -eq 0 -or $null -eq $cacheMac) {
        $cacheMac = Get-MacState
        $pipe = Get-ClashPipePath
        $cacheRoute = Get-Route $pipe
      }
      $port = Test-TcpPort $Cfg.socksPort 500
      $socks = $false
      if ($port) { $socks = Test-SocksHttp 8 }
      $sys = Get-SystemMetrics
      $snap = [ordered]@{
        ts          = (Get-Date).ToString('o')
        macKnown    = $cacheMac.known
        macOnline   = $cacheMac.online
        macLastSeen = $cacheMac.lastSeen
        tsState     = [string]$cacheMac.tsState
        portUp      = $port
        socksOk     = $socks
        routeOk     = $cacheRoute.ok
        route       = $cacheRoute.name
        cpu         = $sys.cpu
        mem         = $sys.mem
        memTotalGB  = $sys.memTotalGB
        memFreeGB   = $sys.memFreeGB
        diskC       = $sys.diskC
        diskD       = $sys.diskD
        gpuUtil     = $sys.gpuUtil
        gpuUsedMB   = $sys.gpuUsedMB
        gpuTotalMB  = $sys.gpuTotalMB
        gpuName     = $sys.gpuName
        codexRun    = $sys.codexRun
        codexPids   = $sys.codexPids
        codexBusy   = $sys.codexBusy
        codexLast   = $sys.codexLast
        dshUp       = $sys.dshUp
        dshPid      = $sys.dshPid
        dshBusy     = $sys.dshBusy
        dshLast     = $sys.dshLast
        neteaseUp   = $sys.neteaseUp
        neteaseTitle= $sys.neteaseTitle
      }
      [IO.File]::WriteAllText($Status, ($snap | ConvertTo-Json -Compress), $Utf8NoBom)
      $tick++
      Start-Sleep -Seconds $IntervalSec
    }
  } catch {
    Write-Log ("worker error: " + $_.Exception.Message)
  } finally {
    Remove-Item $PidFile -Force -ErrorAction SilentlyContinue
    Write-Log "worker stop"
  }
  return
}

if ($Once) {
  Get-Snapshot | ConvertTo-Json
  return
}

# ---------------- floating UI (灵动弹窗: 小胶囊 ⇄ 展开面板, 上下翻页) ----------------
$mutex = New-Object System.Threading.Mutex($false, 'Local\MacTunnelStatusWidget')
if (-not $mutex.WaitOne(0)) { Write-Log 'widget already running'; return }

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()
[System.Windows.Forms.Application]::SetCompatibleTextRenderingDefault($false)

# 提亮后的调色板
$C_Back    = [System.Drawing.Color]::FromArgb(22, 23, 28)
$C_Line    = [System.Drawing.Color]::FromArgb(58, 62, 72)
$C_Title   = [System.Drawing.Color]::FromArgb(244, 246, 251)
$C_Text    = [System.Drawing.Color]::FromArgb(214, 220, 230)
$C_Label   = [System.Drawing.Color]::FromArgb(170, 178, 190)
$C_Faint   = [System.Drawing.Color]::FromArgb(128, 136, 150)
$C_Ok      = [System.Drawing.Color]::FromArgb(110, 235, 160)
$C_Warn    = [System.Drawing.Color]::FromArgb(255, 205, 90)
$C_Bad     = [System.Drawing.Color]::FromArgb(255, 130, 130)

$W_E = 322; $H_E = 282          # 展开尺寸
$W_C = 244; $H_C = 56           # 胶囊尺寸（两行）
$PadX = 16

$F_Title = New-Object System.Drawing.Font('Microsoft YaHei UI', 11.0, [System.Drawing.FontStyle]::Bold)
$F_Sub   = New-Object System.Drawing.Font('Microsoft YaHei UI', 8.4, [System.Drawing.FontStyle]::Regular)
$F_Row   = New-Object System.Drawing.Font('Microsoft YaHei UI', 9.2, [System.Drawing.FontStyle]::Regular)
$F_Val   = New-Object System.Drawing.Font('Microsoft YaHei UI', 9.2, [System.Drawing.FontStyle]::Bold)
$F_Small = New-Object System.Drawing.Font('Microsoft YaHei UI', 8.8, [System.Drawing.FontStyle]::Regular)
$F_Pill  = New-Object System.Drawing.Font('Microsoft YaHei UI', 8.4, [System.Drawing.FontStyle]::Bold)
$F_Page  = New-Object System.Drawing.Font('Microsoft YaHei UI', 9.4, [System.Drawing.FontStyle]::Regular)

$form = New-Object System.Windows.Forms.Form
$form.Text = '状态台'
$form.FormBorderStyle = 'None'
$form.TopMost = $true
$form.ShowInTaskbar = $false
$form.StartPosition = 'Manual'
$form.BackColor = $C_Back
$form.Opacity = 0.99
$bp = $form.GetType().GetProperty('DoubleBuffered', [System.Reflection.BindingFlags]'Instance,NonPublic,Public')
if ($bp) { $bp.SetValue($form, $true) }

$wsArea = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea
$script:anchorRight = $wsArea.Right - 18
$script:top = $wsArea.Top + 20
$script:size = @{ w = $W_C; h = $H_C }
$script:mode = 'compact'
$script:animating = $false
$script:dragging = $false
$script:dragPt = New-Object System.Drawing.Point(0, 0)

function New-RoundedPath([double]$x, [double]$y, [double]$w, [double]$h, [double]$r2) {
  $p2 = New-Object System.Drawing.Drawing2D.GraphicsPath
  $d = $r2 * 2
  if ($d -gt $w) { $d = $w }
  if ($d -gt $h) { $d = $h }
  if ($d -le 0) { return $p2 }
  $p2.AddArc([single]$x, [single]$y, [single]$d, [single]$d, 180, 90)
  $p2.AddArc([single]($x + $w - $d), [single]$y, [single]$d, [single]$d, 270, 90)
  $p2.AddArc([single]($x + $w - $d), [single]($y + $h - $d), [single]$d, [single]$d, 0, 90)
  $p2.AddArc([single]$x, [single]($y + $h - $d), [single]$d, [single]$d, 90, 90)
  $p2.CloseFigure()
  return $p2
}

function Set-Geometry {
  $w = [int]$script:size.w
  $h = [int]$script:size.h
  $x = [int]($script:anchorRight - $w)
  $form.Bounds = New-Object System.Drawing.Rectangle($x, $script:top, $w, $h)
  if ($script:animating) { if ($form.Region) { $form.Region = $null }; return }
  $frac = 0.0
  if (($H_E - $H_C) -gt 0) { $frac = ([double]$h - $H_C) / ($H_E - $H_C) }
  if ($frac -lt 0) { $frac = 0 }
  if ($frac -gt 1) { $frac = 1 }
  $r = (20.0 * (1 - $frac)) + (12.0 * $frac)
  $maxR = [math]::Min($w, $h) / 2
  if ($r -gt $maxR) { $r = $maxR }
  $path = New-RoundedPath 0 0 $w $h $r
  $old = $form.Region
  $form.Region = New-Object System.Drawing.Region($path)
  if ($old) { $old.Dispose() }
  $path.Dispose()
}

function Get-BarColor([double]$pct) {
  if ($pct -ge 88) { return $C_Bad }
  if ($pct -ge 65) { return $C_Warn }
  return $C_Ok
}

$script:view = @{
