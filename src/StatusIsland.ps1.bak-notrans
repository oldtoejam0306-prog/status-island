  metrics = @(
    @{ l = 'CPU'; v = '—'; pct = 0; c = $C_Faint },
    @{ l = '内存'; v = '—'; pct = 0; c = $C_Faint },
    @{ l = '磁盘 D'; v = '—'; pct = 0; c = $C_Faint },
    @{ l = 'GPU'; v = '—'; pct = 0; c = $C_Faint }
  )
  chips = @(
