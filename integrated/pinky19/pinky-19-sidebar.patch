@@ -0,0 +1,338 @@
+package ui
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const (
+	panelHostSchema        = "pinky.sidebar-host.v1"
+	panelHostMaxBytes      = 16 << 10
+	panelHostLeaseDuration = 3 * time.Second
+	panelHostMaxDimension  = 32768
+	panelHostMaxDPI        = 9600
+	panelHostMaxSequence   = 1<<53 - 1
+)
+
+// panelHostSpec is a parsed host.json. Its exported fields are available to
+// the Windows-specific files in this package; none of them establish that a
+// process or HWND is trusted. The caller must verify those facts with Windows.
+type panelHostSpec struct {
+	Schema               string
+	Nonce                string
+	Sequence             uint64
+	PID                  int
+	ProcessBirthFileTime uint64
+	HWND                 uint64
+	UpdatedUTC           time.Time
+	Visible              bool
+	ClientRectPhysical   panelHostRect
+	DPI                  int
+}
+
+// panelHostRect is the host client area in physical screen pixels.
+type panelHostRect struct {
+	X      int32
+	Y      int32
+	Width  int32
+	Height int32
+}
+
+type panelHostDocument struct {
+	Schema               *string           `json:"schema"`
+	Nonce                *string           `json:"nonce"`
+	Sequence             *json.Number      `json:"sequence"`
+	PID                  *json.Number      `json:"pid"`
+	ProcessBirthFileTime *string           `json:"processBirthFileTime"`
+	HWND                 *string           `json:"hwnd"`
+	UpdatedUTC           *string           `json:"updatedUtc"`
+	Visible              *bool             `json:"visible"`
+	ClientRectPhysical   *panelHostRectDoc `json:"clientRectPhysical"`
+	DPI                  *json.Number      `json:"dpi"`
+}
+
+type panelHostRectDoc struct {
+	X      *json.Number `json:"x"`
+	Y      *json.Number `json:"y"`
+	Width  *json.Number `json:"width"`
+	Height *json.Number `json:"height"`
+}
+
+// parsePanelHost validates the host lease document's format and freshness.
+// It deliberately does not verify the OS process, window handle, or DPI mode.
+func parsePanelHost(data []byte, now time.Time) (panelHostSpec, error) {
+	if len(data) == 0 || len(data) > panelHostMaxBytes {
+		return panelHostSpec{}, fmt.Errorf("host document size must be between 1 and %d bytes", panelHostMaxBytes)
+	}
+	if !utf8.Valid(data) {
+		return panelHostSpec{}, errors.New("host document is not valid UTF-8")
+	}
+	if err := rejectDuplicatePanelHostKeys(data); err != nil {
+		return panelHostSpec{}, err
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.UseNumber()
+	dec.DisallowUnknownFields()
+	var doc panelHostDocument
+	if err := dec.Decode(&doc); err != nil {
+		return panelHostSpec{}, fmt.Errorf("decode host document: %w", err)
+	}
+	var trailing any
+	if err := dec.Decode(&trailing); !errors.Is(err, io.EOF) {
+		if err == nil {
+			return panelHostSpec{}, errors.New("host document has trailing JSON")
+		}
+		return panelHostSpec{}, fmt.Errorf("read host document trailer: %w", err)
+	}
+	if doc.Schema == nil || doc.Nonce == nil || doc.Sequence == nil || doc.PID == nil || doc.ProcessBirthFileTime == nil || doc.HWND == nil || doc.UpdatedUTC == nil || doc.Visible == nil || doc.ClientRectPhysical == nil || doc.DPI == nil {
+		return panelHostSpec{}, errors.New("host document is missing a required field")
+	}
+	if *doc.Schema != panelHostSchema {
+		return panelHostSpec{}, fmt.Errorf("unsupported host schema %q", *doc.Schema)
+	}
+	if !validPanelHostNonce(*doc.Nonce) {
+		return panelHostSpec{}, errors.New("host nonce must be 32 hexadecimal characters")
+	}
+	sequence, err := parsePanelHostPositiveUint(*doc.Sequence, panelHostMaxSequence, "sequence")
+	if err != nil {
+		return panelHostSpec{}, err
+	}
+
+	pid, err := parsePanelHostPositiveInt(*doc.PID, math.MaxInt32, "pid")
+	if err != nil {
+		return panelHostSpec{}, err
+	}
+	fileTime, err := strconv.ParseUint(*doc.ProcessBirthFileTime, 10, 64)
+	if err != nil || fileTime == 0 {
+		return panelHostSpec{}, errors.New("processBirthFileTime must be a positive uint64 decimal string")
+	}
+	if !strings.HasPrefix(*doc.HWND, "0x") || len(*doc.HWND) <= 2 {
+		return panelHostSpec{}, errors.New("hwnd must be a positive hexadecimal string with 0x prefix")
+	}
+	for _, c := range (*doc.HWND)[2:] {
+		if (c < '0' || c > '9') && (c < 'a' || c > 'f') && (c < 'A' || c > 'F') {
+			return panelHostSpec{}, errors.New("hwnd must contain only hexadecimal digits after 0x")
+		}
+	}
+	hwnd, err := strconv.ParseUint((*doc.HWND)[2:], 16, 64)
+	if err != nil || hwnd == 0 {
+		return panelHostSpec{}, errors.New("hwnd must be a positive uint64 hexadecimal string")
+	}
+	dpi, err := parsePanelHostPositiveInt(*doc.DPI, panelHostMaxDPI, "dpi")
+	if err != nil {
+		return panelHostSpec{}, err
+	}
+
+	updated, err := time.Parse(time.RFC3339Nano, *doc.UpdatedUTC)
+	if err != nil {
+		return panelHostSpec{}, fmt.Errorf("updatedUtc must be RFC3339Nano: %w", err)
+	}
+	_, offset := updated.Zone()
+	if offset != 0 {
+		return panelHostSpec{}, errors.New("updatedUtc must use UTC")
+	}
+	updated = updated.UTC()
+	if updated.After(now.Add(time.Second)) {
+		return panelHostSpec{}, errors.New("host document timestamp is more than one second in the future")
+	}
+	if now.Sub(updated) > panelHostLeaseDuration {
+		return panelHostSpec{}, errors.New("host document is more than three seconds old")
+	}
+
+	rect, err := parsePanelHostRect(doc.ClientRectPhysical)
+	if err != nil {
+		return panelHostSpec{}, err
+	}
+	return panelHostSpec{
+		Schema:               *doc.Schema,
+		Nonce:                *doc.Nonce,
+		Sequence:             sequence,
+		PID:                  pid,
+		ProcessBirthFileTime: fileTime,
+		HWND:                 hwnd,
+		UpdatedUTC:           updated,
+		Visible:              *doc.Visible,
+		ClientRectPhysical:   rect,
+		DPI:                  dpi,
+	}, nil
+}
+
+func parsePanelHostPositiveUint(value json.Number, max uint64, name string) (uint64, error) {
+	for _, c := range value.String() {
+		if c < '0' || c > '9' {
+			return 0, fmt.Errorf("%s must contain only decimal digits", name)
+		}
+	}
+	n, err := strconv.ParseUint(value.String(), 10, 64)
+	if err != nil || n == 0 || n > max {
+		return 0, fmt.Errorf("%s must be a positive integer no greater than %d", name, max)
+	}
+	return n, nil
+}
+
+func validPanelHostNonce(nonce string) bool {
+	if len(nonce) != 32 {
+		return false
+	}
+	for _, c := range nonce {
+		if (c < '0' || c > '9') && (c < 'a' || c > 'f') && (c < 'A' || c > 'F') {
+			return false
+		}
+	}
+	return true
+}
+
+func rejectDuplicatePanelHostKeys(data []byte) error {
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.UseNumber()
+	if err := scanPanelHostJSONValue(dec); err != nil {
+		return fmt.Errorf("validate host JSON keys: %w", err)
+	}
+	var trailing any
+	if err := dec.Decode(&trailing); !errors.Is(err, io.EOF) {
+		return errors.New("host document has trailing JSON")
+	}
+	return nil
+}
+
+func scanPanelHostJSONValue(dec *json.Decoder) error {
+	tok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	delim, ok := tok.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := make(map[string]struct{})
+		for dec.More() {
+			key, err := dec.Token()
+			if err != nil {
+				return err
+			}
+			name, ok := key.(string)
+			if !ok {
+				return errors.New("object key is not a string")
+			}
+			if _, exists := seen[name]; exists {
+				return fmt.Errorf("duplicate object key %q", name)
+			}
+			seen[name] = struct{}{}
+			if err := scanPanelHostJSONValue(dec); err != nil {
+				return err
+			}
+		}
+		end, err := dec.Token()
+		if err != nil || end != json.Delim('}') {
+			return errors.New("unterminated object")
+		}
+	case '[':
+		for dec.More() {
+			if err := scanPanelHostJSONValue(dec); err != nil {
+				return err
+			}
+		}
+		end, err := dec.Token()
+		if err != nil || end != json.Delim(']') {
+			return errors.New("unterminated array")
+		}
+	default:
+		return fmt.Errorf("unexpected JSON delimiter %q", delim)
+	}
+	return nil
+}
+
+func parsePanelHostPositiveInt(value json.Number, max int, name string) (int, error) {
+	n, err := strconv.ParseInt(value.String(), 10, 64)
+	if err != nil || n <= 0 || n > int64(max) {
+		return 0, fmt.Errorf("%s must be a positive integer no greater than %d", name, max)
+	}
+	return int(n), nil
+}
+
+func parsePanelHostRect(doc *panelHostRectDoc) (panelHostRect, error) {
+	if doc.X == nil || doc.Y == nil || doc.Width == nil || doc.Height == nil {
+		return panelHostRect{}, errors.New("clientRectPhysical is missing a required field")
+	}
+	x, err := parsePanelHostCoordinate(*doc.X, "clientRectPhysical.x")
+	if err != nil {
+		return panelHostRect{}, err
+	}
+	y, err := parsePanelHostCoordinate(*doc.Y, "clientRectPhysical.y")
+	if err != nil {
+		return panelHostRect{}, err
+	}
+	w, err := parsePanelHostDimension(*doc.Width, "clientRectPhysical.width")
+	if err != nil {
+		return panelHostRect{}, err
+	}
+	h, err := parsePanelHostDimension(*doc.Height, "clientRectPhysical.height")
+	if err != nil {
+		return panelHostRect{}, err
+	}
+	return panelHostRect{X: x, Y: y, Width: w, Height: h}, nil
+}
+
+func parsePanelHostCoordinate(value json.Number, name string) (int32, error) {
+	n, err := strconv.ParseInt(value.String(), 10, 32)
+	if err != nil {
+		return 0, fmt.Errorf("%s must be an int32 coordinate", name)
+	}
+	return int32(n), nil
+}
+
+func parsePanelHostDimension(value json.Number, name string) (int32, error) {
+	n, err := strconv.ParseInt(value.String(), 10, 32)
+	if err != nil || n <= 0 || n > panelHostMaxDimension {
+		return 0, fmt.Errorf("%s must be between 1 and %d", name, panelHostMaxDimension)
+	}
+	return int32(n), nil
+}
+
+// panelHostLease tracks progress using the receiver's local clock. Re-reading
+// an unchanged host.json never renews the lease.
+type panelHostLease struct {
+	spec       panelHostSpec
+	sequence   uint64
+	lastUpdate time.Time
+	seenAt     time.Time
+}
+
+func (l *panelHostLease) observe(spec panelHostSpec, now time.Time) bool {
+	if l.spec.Nonce == "" || spec.Nonce != l.spec.Nonce {
+		l.spec = spec
+		l.sequence = spec.Sequence
+		l.lastUpdate = spec.UpdatedUTC
+		l.seenAt = now
+		return true
+	}
+	if spec.PID != l.spec.PID || spec.ProcessBirthFileTime != l.spec.ProcessBirthFileTime || spec.HWND != l.spec.HWND {
+		return false
+	}
+	if spec.Sequence <= l.sequence || spec.UpdatedUTC.Before(l.lastUpdate) {
+		return false
+	}
+	l.spec = spec
+	l.sequence = spec.Sequence
+	l.lastUpdate = spec.UpdatedUTC
+	l.seenAt = now
+	return true
+}
+
+func (l panelHostLease) valid(now time.Time) bool {
+	if l.spec.Nonce == "" {
+		return false
+	}
+	elapsed := now.Sub(l.seenAt)
+	return elapsed >= 0 && elapsed < panelHostLeaseDuration
+}
