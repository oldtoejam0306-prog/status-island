+				t.Fatal("expected invalid host document to be rejected")
+			}
+		})
+	}
+}
+
+func TestPanelHostLeaseSequenceAndNonce(t *testing.T) {
+	base := time.Date(2026, 11, 10, 0, 0, 0, 0, time.UTC)
+	spec := panelHostSpec{Schema: panelHostSchema, Nonce: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", Sequence: 1, UpdatedUTC: base, Visible: true}
+	var lease panelHostLease
+	if !lease.observe(spec, base) || !lease.valid(base) {
+		t.Fatal("first host heartbeat did not establish a lease")
+	}
+
+	duplicate := spec
+	duplicate.Sequence = 1
+	duplicate.UpdatedUTC = base.Add(time.Second)
+	duplicate.Visible = false
+	duplicate.ClientRectPhysical.X = -20
+	if lease.observe(duplicate, base.Add(time.Second)) {
+		t.Fatal("duplicate sequence refreshed the lease")
+	}
+	if !lease.spec.Visible || lease.spec.ClientRectPhysical.X != 0 {
+		t.Fatal("duplicate sequence replaced the last host state")
+	}
+
+	backwards := spec
+	backwards.Sequence = 2
+	backwards.UpdatedUTC = base.Add(-time.Nanosecond)
+	if lease.observe(backwards, base.Add(time.Second)) {
+		t.Fatal("backwards timestamp refreshed the lease")
+	}
+
+	advanced := spec
+	advanced.Sequence = 2
+	advanced.UpdatedUTC = base.Add(time.Second)
+	if !lease.observe(advanced, base.Add(time.Second)) || !lease.valid(base.Add(3*time.Second-time.Nanosecond)) {
+		t.Fatal("advanced sequence did not renew the lease")
+	}
+	if lease.valid(base.Add(4 * time.Second)) {
+		t.Fatal("lease remained valid at the three-second boundary")
+	}
+
+	newHost := advanced
+	newHost.Nonce = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+	newHost.Sequence = 1
+	newHost.UpdatedUTC = base.Add(2 * time.Second)
+	newHost.PID = 4321
+	newHost.ProcessBirthFileTime++
+	newHost.HWND++
+	if !lease.observe(newHost, base.Add(4*time.Second)) || !lease.valid(base.Add(4*time.Second)) {
+		t.Fatal("new nonce did not reset the lease")
+	}
+}
+
+func TestPanelHostLeaseIdentityIsStableWithinNonce(t *testing.T) {
+	base := time.Date(2026, 11, 10, 0, 0, 0, 0, time.UTC)
+	original := panelHostSpec{
+		Schema: panelHostSchema, Nonce: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", Sequence: 1,
+		PID: 1234, ProcessBirthFileTime: 100, HWND: 0x1234, UpdatedUTC: base,
+	}
+	changes := []struct {
+		name   string
+		mutate func(*panelHostSpec)
+	}{
+		{name: "pid", mutate: func(s *panelHostSpec) { s.PID++ }},
+		{name: "process birth", mutate: func(s *panelHostSpec) { s.ProcessBirthFileTime++ }},
+		{name: "hwnd", mutate: func(s *panelHostSpec) { s.HWND++ }},
+	}
+	for _, change := range changes {
+		t.Run(change.name, func(t *testing.T) {
+			lease := panelHostLease{}
+			lease.observe(original, base)
+			candidate := original
+			candidate.Sequence = 2
+			candidate.UpdatedUTC = base.Add(time.Second)
+			change.mutate(&candidate)
+			if lease.observe(candidate, base.Add(time.Second)) {
+				t.Fatal("changed identity renewed the lease")
+			}
+			if lease.spec != original {
+				t.Fatalf("changed identity replaced the host state: %+v", lease.spec)
+			}
+			if lease.valid(base.Add(panelHostLeaseDuration)) {
+				t.Fatal("changed identity extended the original lease")
+			}
+		})
+	}
+}
