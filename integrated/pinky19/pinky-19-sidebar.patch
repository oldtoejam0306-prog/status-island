+++ b/ui/handoff_ack_test.go
@@ -0,0 +1,229 @@
+package ui
+
+import (
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/DIYgod/pinky/internal/gateway"
+	"github.com/DIYgod/pinky/ui/fakeapi"
+	mg "github.com/egoist/mygo/ui"
+)
+
+type handoffDecisionAPI struct {
+	gateway.API
+	answer func(string, gateway.Decision, string) error
+}
+
+func (a *handoffDecisionAPI) Decide(id string, decision gateway.Decision, note string) error {
+	return a.answer(id, decision, note)
+}
+
+func drainHandoffPosts(ta *testApp) {
+	ta.mu.Lock()
+	queue := ta.q
+	ta.q = nil
+	ta.mu.Unlock()
+	for _, fn := range queue {
+		fn()
+	}
+}
+
+func waitHandoffPosts(t *testing.T, ta *testApp, ready func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		drainHandoffPosts(ta)
+		if ready() {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("gateway response was not applied")
+}
+
+func handoffAckApp(t *testing.T) (*testApp, gateway.NeedView) {
+	t.Helper()
+	ta := newTestApp(t, fakeapi.OnePhone)
+	n := gateway.NeedView{ID: "handoff-ack-fixture", Kind: gateway.NeedHandoff,
+		DeviceID: "fake-phone", TaskID: "fake-task", Created: time.Now(), Deadline: time.Now().Add(time.Minute)}
+	ta.needs = []gateway.NeedView{n}
+	ta.noting[n.ID] = true
+	return ta, n
+}
+
+func TestHandoffConfirmationWaitsForGateway(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	called, release := make(chan struct{}), make(chan struct{})
+	defer close(release)
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(id string, decision gateway.Decision, note string) error {
+		if id != n.ID || decision != gateway.AllowOnce || note != "fixture note" {
+			t.Error("handoff request identity or decision changed")
+		}
+		close(called)
+		<-release
+		return nil
+	}}
+	ta.decide(n, gateway.AllowOnce, "fixture note")
+	<-called
+	if len(ta.answered) != 0 || !ta.noting[n.ID] {
+		t.Fatal("handoff shown as completed before gateway response")
+	}
+	tt := mg.NewTester(func(c *mg.Context) { ta.handoffControls(c, n) }, 360, 400)
+	if !hasText(tt, "Submitting") || hasText(tt, "Handed back") {
+		t.Fatalf("pending handoff feedback: %q", tt.Texts())
+	}
+}
+
+func TestHandoffConfirmationAfterSuccessfulResponse(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(string, gateway.Decision, string) error { return nil }}
+	ta.decide(n, gateway.AllowOnce, "fixture note")
+	waitHandoffPosts(t, ta, func() bool { return len(ta.answered) == 1 })
+	answer := ta.answered[0]
+	if answer.need.ID != n.ID || answer.d != gateway.AllowOnce || answer.note != "fixture note" || ta.noting[n.ID] {
+		t.Fatal("successful handoff confirmation lost request identity, decision or note")
+	}
+}
+
+func TestHandoffFailureKeepsRequestAndAllowsRetry(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	requestError := errors.New("fixture gateway refused the stale request")
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(string, gateway.Decision, string) error { return requestError }}
+	ta.decide(n, gateway.AllowOnce, "fixture note")
+	waitHandoffPosts(t, ta, func() bool { return len(ta.toasts) > 0 })
+	if len(ta.answered) != 0 || !ta.noting[n.ID] || len(ta.needs) != 1 || ta.needs[0].ID != n.ID {
+		t.Fatal("failed handoff was confirmed or removed instead of remaining retryable")
+	}
+	tt := mg.NewTester(func(c *mg.Context) { ta.handoffControls(c, n) }, 360, 400)
+	if !hasText(tt, requestError.Error()) || !hasText(tt, "Done") {
+		t.Fatalf("failed handoff has no retry feedback: %q", tt.Texts())
+	}
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(string, gateway.Decision, string) error { return nil }}
+	ta.decide(n, gateway.AllowOnce, "fixture note")
+	waitHandoffPosts(t, ta, func() bool { return len(ta.answered) == 1 })
+}
+
+func TestHandoffQueuedDecisionHasNoSuccessConfirmation(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	queue := make(chan func(), 1)
+	queue <- func() {}
+	ta.callQueue[n.DeviceID] = queue
+	ta.decide(n, gateway.AllowOnce, "fixture note")
+	if len(ta.answered) != 0 || !ta.noting[n.ID] {
+		t.Fatal("handoff displayed as completed even though the gateway queue rejected the request")
+	}
+	reply := ta.handoffReplies[n.ID]
+	if reply == nil || reply.pending || reply.message == "" {
+		t.Fatal("full queue did not leave an actionable error")
+	}
+	<-queue
+	ta.decide(n, gateway.AllowOnce, "fixture note")
+	if len(queue) != 1 || !ta.handoffReplies[n.ID].pending {
+		t.Fatal("full-queue handoff could not be retried")
+	}
+}
+
+func TestHandoffDuplicateAndReplacedRequest(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	called, release := make(chan struct{}, 2), make(chan struct{})
+	var count atomic.Int32
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(string, gateway.Decision, string) error {
+		count.Add(1)
+		called <- struct{}{}
+		<-release
+		return nil
+	}}
+	ta.decide(n, gateway.AllowOnce, "")
+	<-called
+	ta.decide(n, gateway.AllowOnce, "")
+	if count.Load() != 1 {
+		t.Fatal("duplicate pending handoff was sent")
+	}
+	close(release)
+	waitHandoffPosts(t, ta, func() bool { return len(ta.answered) == 1 })
+	ta.decide(n, gateway.AllowOnce, "")
+	if count.Load() != 1 {
+		t.Fatal("acknowledged handoff was sent twice")
+	}
+	next := n
+	next.ID = "next-handoff-fixture"
+	ta.needs = []gateway.NeedView{next}
+	ta.decide(n, gateway.AllowOnce, "")
+	if count.Load() != 1 {
+		t.Fatal("old handoff was sent after a newer request arrived")
+	}
+	ta.decide(next, gateway.AllowOnce, "")
+	waitHandoffPosts(t, ta, func() bool { return len(ta.answered) == 2 })
+	if count.Load() != 2 || ta.answered[1].need.ID != next.ID {
+		t.Fatal("new handoff inherited a previous request's acknowledgement")
+	}
+}
+
+func TestHandoffDeclineKeepsDeclineMeaning(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(string, gateway.Decision, string) error { return nil }}
+	ta.decide(n, gateway.Deny, "fixture decline")
+	waitHandoffPosts(t, ta, func() bool { return len(ta.answered) == 1 })
+	tt := mg.NewTester(func(c *mg.Context) { ta.handoffControls(c, n) }, 360, 400)
+	if !hasText(tt, "Declined") || hasText(tt, "Handed back") {
+		t.Fatalf("decline was displayed as a hand-back: %q", tt.Texts())
+	}
+}
+
+func TestHandoffTakeOverStillAllowsDone(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	var decisions []gateway.Decision
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(_ string, decision gateway.Decision, _ string) error {
+		decisions = append(decisions, decision)
+		return nil
+	}}
+	ta.decide(n, gateway.TakeOver, "")
+	waitHandoffPosts(t, ta, func() bool { return ta.handoffReplies[n.ID] == nil })
+	if len(ta.answered) != 0 {
+		t.Fatal("taking over was displayed as completing a handoff")
+	}
+	ta.decide(n, gateway.AllowOnce, "")
+	waitHandoffPosts(t, ta, func() bool { return len(ta.answered) == 1 })
+	if len(decisions) != 2 || decisions[0] != gateway.TakeOver || decisions[1] != gateway.AllowOnce {
+		t.Fatal("taking over prevented the later hand-back")
+	}
+}
+
+func TestHandoffLateResponseDoesNotReplaceNewCard(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	called, release := make(chan struct{}), make(chan struct{})
+	defer close(release)
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(string, gateway.Decision, string) error {
+		close(called)
+		<-release
+		return nil
+	}}
+	ta.decide(n, gateway.AllowOnce, "old note")
+	<-called
+	next := n
+	next.ID = "replacement-handoff-fixture"
+	ta.seenNeed[next.ID] = true
+	ta.setNeeds([]gateway.NeedView{next})
+	if ta.handoffReplies[n.ID] != nil || len(ta.needs) != 1 || ta.needs[0].ID != next.ID {
+		t.Fatal("replaced request state was retained")
+	}
+	// A response queued for an older request must not show over the newer card.
+	release <- struct{}{}
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		ta.mu.Lock()
+		posted := len(ta.q) > 0
+		ta.mu.Unlock()
+		if posted {
+			drainHandoffPosts(ta)
+			if len(ta.answered) != 0 || ta.needs[0].ID != next.ID {
+				t.Fatal("late acknowledgement replaced the current request")
+			}
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("late response was not observed")
+}
