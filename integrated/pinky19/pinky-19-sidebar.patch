+func TestParsePanelHostRejectsInvalidDocuments(t *testing.T) {
+	now := time.Date(2026, 11, 10, 0, 0, 0, 0, time.UTC)
+	tests := []struct {
+		name string
+		edit func(map[string]any)
+		raw  func([]byte) []byte
+	}{
+		{name: "missing field", edit: func(d map[string]any) { delete(d, "sequence") }},
+		{name: "unknown field", edit: func(d map[string]any) { d["extra"] = true }},
+		{name: "wrong schema", edit: func(d map[string]any) { d["schema"] = "pinky.sidebar-host.v2" }},
+		{name: "short nonce", edit: func(d map[string]any) { d["nonce"] = "1234" }},
+		{name: "non-hex nonce", edit: func(d map[string]any) { d["nonce"] = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz" }},
+		{name: "zero sequence", edit: func(d map[string]any) { d["sequence"] = json.Number("0") }},
+		{name: "fractional sequence", edit: func(d map[string]any) { d["sequence"] = json.Number("1.5") }},
+		{name: "unsafe sequence", edit: func(d map[string]any) { d["sequence"] = json.Number("9007199254740992") }},
+		{name: "zero pid", edit: func(d map[string]any) { d["pid"] = json.Number("0") }},
+		{name: "fractional pid", edit: func(d map[string]any) { d["pid"] = json.Number("12.25") }},
+		{name: "zero process birth", edit: func(d map[string]any) { d["processBirthFileTime"] = "0" }},
+		{name: "signed process birth", edit: func(d map[string]any) { d["processBirthFileTime"] = "+1" }},
+		{name: "overflow process birth", edit: func(d map[string]any) { d["processBirthFileTime"] = "18446744073709551616" }},
+		{name: "zero hwnd", edit: func(d map[string]any) { d["hwnd"] = "0x0" }},
+		{name: "malformed hwnd", edit: func(d map[string]any) { d["hwnd"] = "0xxyz" }},
+		{name: "signed hwnd", edit: func(d map[string]any) { d["hwnd"] = "0x+1" }},
+		{name: "zero dpi", edit: func(d map[string]any) { d["dpi"] = json.Number("0") }},
+		{name: "excessive dpi", edit: func(d map[string]any) { d["dpi"] = panelHostMaxDPI + 1 }},
+		{name: "non-UTC timestamp", edit: func(d map[string]any) { d["updatedUtc"] = "2026-11-10T08:00:00+08:00" }},
+		{name: "invalid timestamp", edit: func(d map[string]any) { d["updatedUtc"] = "yesterday" }},
+		{name: "future timestamp", edit: func(d map[string]any) {
+			d["updatedUtc"] = now.Add(time.Second + time.Nanosecond).Format(time.RFC3339Nano)
+		}},
+		{name: "stale timestamp", edit: func(d map[string]any) {
+			d["updatedUtc"] = now.Add(-panelHostLeaseDuration - time.Nanosecond).Format(time.RFC3339Nano)
+		}},
+		{name: "coordinate overflow", edit: func(d map[string]any) { d["clientRectPhysical"].(map[string]any)["x"] = json.Number("2147483648") }},
+		{name: "zero dimension", edit: func(d map[string]any) { d["clientRectPhysical"].(map[string]any)["width"] = 0 }},
+		{name: "excessive dimension", edit: func(d map[string]any) { d["clientRectPhysical"].(map[string]any)["height"] = panelHostMaxDimension + 1 }},
+		{name: "missing rectangle field", edit: func(d map[string]any) { delete(d["clientRectPhysical"].(map[string]any), "height") }},
+		{name: "trailing JSON", raw: func(b []byte) []byte { return append(b, []byte(` {}`)...) }},
+		{name: "duplicate key", raw: func(b []byte) []byte {
+			return bytes.Replace(b, []byte(`"schema":"pinky.sidebar-host.v1"`), []byte(`"schema":"x","schema":"pinky.sidebar-host.v1"`), 1)
+		}},
+		{name: "oversized JSON", raw: func(b []byte) []byte { return append(b, []byte(strings.Repeat(" ", panelHostMaxBytes+1))...) }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			doc := panelHostTestDocument(now)
+			if tt.edit != nil {
+				tt.edit(doc)
