+type sidebarAppearance struct {
+	Schema string `json:"schema"`
+	Theme  string `json:"theme"`
+}
+
+var sidebarAppearanceCache = struct {
+	sync.Mutex
+	checked  time.Time
+	name     string
+	disabled bool
+}{name: "tide"}
+
+func validSidebarTheme(name string) string {
+	switch strings.ToLower(strings.TrimSpace(name)) {
+	case "pine", "iris", "amber":
+		return strings.ToLower(strings.TrimSpace(name))
+	default:
+		return "tide"
+	}
+}
+
+func sidebarThemeName() string {
+	now := time.Now()
+	sidebarAppearanceCache.Lock()
+	defer sidebarAppearanceCache.Unlock()
+	if now.Sub(sidebarAppearanceCache.checked) < 500*time.Millisecond {
+		return sidebarAppearanceCache.name
+	}
+	name := validSidebarTheme(os.Getenv("PINKY_SIDEBAR_THEME"))
+	if !sidebarAppearanceCache.disabled {
+		if directory := os.Getenv("PINKY_PANEL_HOST_DIR"); directory != "" {
+			data, err := readSidebarAppearanceFile(filepath.Join(directory, "appearance.json"), 4096)
+			if errors.Is(err, os.ErrPermission) {
+				sidebarAppearanceCache.disabled = true
+			} else if err == nil && len(data) <= 4096 {
+				var appearance sidebarAppearance
+				if json.Unmarshal(data, &appearance) == nil && appearance.Schema == "pinky.sidebar-appearance.v1" {
+					switch appearance.Theme {
+					case "tide", "pine", "iris", "amber":
+						name = appearance.Theme
+					}
+				}
+			}
+		}
+	}
+	sidebarAppearanceCache.checked = now
+	sidebarAppearanceCache.name = name
+	return name
+}
+
+type sidebarColors struct {
+	top, base, face, text, secondary, accent string
+}
+
+func colorsForSidebarTheme(name string) sidebarColors {
+	switch validSidebarTheme(name) {
+	case "pine":
+		return sidebarColors{"#2d4f41", "#19352c", "#8bc7a2", "#eef5f7", "#c3d8cf", "#6abb9a"}
+	case "iris":
+		return sidebarColors{"#493958", "#31253c", "#be9dda", "#f4eef9", "#cfc2dc", "#ba93d8"}
+	case "amber":
+		return sidebarColors{"#524135", "#372b23", "#d6b383", "#f7efe6", "#dbc9b6", "#d5a575"}
+	default:
+		return sidebarColors{"#304a5c", "#1c2f3e", "#8ebcdc", "#eef5f7", "#c3d3df", "#6baee8"}
+	}
+}
+
+func sidebarThemePalette(name string) *palette {
+	colors := colorsForSidebarTheme(name)
+	top, base := mg.Hex(colors.top), mg.Hex(colors.base)
+	face, ink, muted := mg.Hex(colors.face), mg.Hex(colors.text), mg.Hex(colors.secondary)
+	accent := mg.Hex(colors.accent)
+	accentButton := accent.Mix(base, 0.50)
+	return &palette{
+		dark: true, sidebar: true,
+		bg: mg.Transparent, bg2: top, bg3: face.Alpha(0.18), sel: face.Alpha(0.24), panel: mg.Transparent,
+		line: accent.Alpha(0.30), line2: accent.Alpha(0.42),
+		ink: ink, ink2: muted, ink3: muted.Alpha(0.82),
+		accent: accent, accentInk: face, accentBtn: accentButton, accentTint: accent.Alpha(0.16),
+		amber: face, amberDot: accent, amberTint: mg.Transparent, amberLine: accent.Alpha(0.42), amberEdge: face,
+		red: mg.Hex("#ef8c83"), redTint: base.Mix(mg.Hex("#ef8c83"), 0.18), redLine: mg.Hex("#ef8c83").Alpha(0.40),
+		green: face, ovl: accent, phone: base,
+		brand: face, lemon: face, shadowLo: mg.RGBA(0, 0, 0, 0.16), shadowHi: mg.RGBA(0, 0, 0, 0.24), white: ink,
+	}
+}
+
+func sidebarPaletteForContext(c *mg.Context) *palette {
+	if c == nil || c.Theme() == nil {
+		return nil
+	}
+	for _, name := range []string{"tide", "pine", "iris", "amber"} {
+		colors := colorsForSidebarTheme(name)
+		if c.Theme().Background == mg.Transparent && c.Theme().Surface == mg.Hex(colors.top) && c.Theme().Focus == mg.Hex(colors.face) {
+			return sidebarThemePalette(name)
+		}
+	}
+	return nil
+}
+
+func applySidebarOverlayTheme(c *mg.Context) *palette {
+	name := sidebarThemeName()
+	p := sidebarThemePalette(name)
+	colors := colorsForSidebarTheme(name)
+	t := *c.Theme()
+	t.Dark = true
+	t.Background, t.Surface = mg.Transparent, p.bg2
+	t.SurfaceHover, t.SurfacePressed = p.bg3, p.sel
+	t.Border, t.Text, t.TextMuted = p.line2, p.ink, p.ink2
+	t.Accent, t.AccentHover, t.AccentPressed, t.AccentText = p.accentBtn, p.accentBtn, p.accentBtn, p.white
+	t.InactiveAccent = t.Accent
+	t.Danger, t.Warning, t.Success = p.red, p.amberDot, p.green
+	t.Focus = mg.Hex(colors.face)
+	t.Selection = p.accent.Alpha(0.28)
+	t.FontSize, t.Radius, t.Spacing = 14, 10, 4
+	c.SetTheme(&t)
+	return p
+}
+
+func paintSidebarGlass(pt *mg.Painter, r mg.Rect, p *palette, radius float32) {
+	colors := colorsForSidebarTheme(sidebarThemeFromPalette(p))
+	top, base, face := mg.Hex(colors.top), mg.Hex(colors.base), mg.Hex(colors.face)
+	pt.FillGradient(r, mg.LinearGradient{From: top.Alpha(188.0 / 255), To: base.Alpha(204.0 / 255), Angle: 180}, radius)
+	pt.Clip(r, radius, func() {
+		sheen := mg.Rect{X: r.X, Y: r.Y - 4, W: r.W, H: min(float32(160), r.H+4)}
+		pt.FillGradient(sheen, mg.LinearGradient{From: mg.RGBA(255, 255, 255, 64.0/255), To: mg.Transparent, Angle: 180}, 0)
+		fillGlow := func(cx, cy, rx, ry float32, color mg.Color, alpha float32) {
+			pt.Transform(mg.Scaling(1, ry/rx), cx, cy, func() {
+				circle := mg.Rect{X: cx - rx, Y: cy - rx, W: rx * 2, H: rx * 2}
+				pt.FillRadialGradient(circle, mg.RadialGradient{Center: mg.Point{X: 0.5, Y: 0.5}, Radius: rx, Stops: []mg.GradientStop{{Color: color.Alpha(alpha), At: 0}, {Color: mg.Transparent, At: 1}}}, 0)
+			})
+		}
+		fillGlow(r.X+r.W*0.72+10, r.Y+30, 100, 90, face, 52.0/255)
+		fillGlow(r.X+r.W*0.04+45, r.Y+r.H*0.30+95, 85, 95, mg.RGB(240, 150, 120), 30.0/255)
+		if r.H > 180 {
+			fillGlow(r.X+r.W*0.50, r.Y+r.H+35, 90, 75, mg.RGB(110, 160, 255), 26.0/255)
+		}
+		cx, cy := r.X+r.W*0.40, r.Y+r.H*0.30
+		extent := r.H + r.W + 400
+		pt.Transform(mg.Rotation(-24), cx, cy, func() {
+			band := mg.Rect{X: cx - 150, Y: cy - extent, W: 300, H: extent * 2}
+			pt.FillGradient(band, mg.LinearGradient{Angle: 90, Stops: []mg.GradientStop{{Color: mg.Transparent, At: 0}, {Color: mg.RGBA(255, 255, 255, 15.0/255), At: 0.5}, {Color: mg.Transparent, At: 1}}}, 0)
+		})
+	})
+}
+
+func sidebarThemeFromPalette(p *palette) string {
+	if p == nil || !p.sidebar {
+		return "tide"
+	}
+	for _, name := range []string{"tide", "pine", "iris", "amber"} {
+		colors := colorsForSidebarTheme(name)
+		if p.bg2 == mg.Hex(colors.top) && p.brand == mg.Hex(colors.face) {
+			return name
+		}
+	}
+	return "tide"
+}
+
+func paintLiquidButton(pt *mg.Painter, r mg.Rect, p *palette, primary, hovered, pressed bool) {
+	base, top := p.phone.Alpha(0.78), p.bg2.Alpha(0.82)
+	if primary {
+		base, top = p.accentBtn.Alpha(0.92), p.accentBtn.Mix(p.bg2, 0.20).Alpha(0.94)
+	}
+	if pressed {
+		base = base.Mix(mg.RGB(0, 0, 0), 0.16)
+	} else if hovered {
+		top = top.Mix(p.brand, 0.12)
+	}
+	pt.Shadow(r, 10, 0, 1, 3, 0, mg.RGBA(0, 0, 0, 0.20))
+	pt.FillGradient(r, mg.LinearGradient{From: top, To: base, Angle: 180}, 10)
+	pt.FillGradient(r, mg.LinearGradient{From: mg.RGBA(255, 255, 255, 44.0/255), To: mg.Transparent, Angle: 180}, 10)
+	pt.Stroke(r, p.brand.Alpha(0.62), 10, 1)
+}
