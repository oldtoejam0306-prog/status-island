+
+func TestSidebarHandoffPendingAndRetryFeedback(t *testing.T) {
+	ta, n := handoffAckApp(t)
+	delete(ta.noting, n.ID)
+	ta.panelHost = &panelHost{}
+	release := make(chan error, 1)
+	defer close(release)
+	ta.app.api = &handoffDecisionAPI{API: ta.api, answer: func(string, gateway.Decision, string) error {
+		return <-release
+	}}
+	ta.decide(n, gateway.AllowOnce, "")
+	tt := mg.NewTester(ta.panelView, panelHostW, panelHostH)
+	if !hasText(tt, locales.NeedsSubmitting()) || hasText(tt, locales.PanelHandedBack()) {
+		t.Fatalf("compact pending feedback: %q", tt.Texts())
+	}
+	release <- errors.New("fixture response failed")
+	waitHandoffPosts(t, ta, func() bool { return !ta.handoffReplies[n.ID].pending })
+	tt = mg.NewTester(ta.panelView, panelHostW, panelHostH)
+	if !hasText(tt, "fixture response failed") || !hasText(tt, locales.NeedsDone()) || hasText(tt, locales.PanelHandedBack()) {
+		t.Fatalf("compact retry feedback: %q", tt.Texts())
+	}
+}
+
+type sidebarDecisionCall struct {
+	id       string
+	decision gateway.Decision
+}
+
+type sidebarRecordingAPI struct {
+	gateway.API
+	calls chan sidebarDecisionCall
+}
+
+func (api *sidebarRecordingAPI) Decide(id string, decision gateway.Decision, note string) error {
+	api.calls <- sidebarDecisionCall{id: id, decision: decision}
+	return nil
+}
+
+func sidebarNeedTest(id, title string) gateway.NeedView {
+	now := time.Now()
+	return gateway.NeedView{
+		ID: id, Kind: gateway.NeedApproval, DeviceID: "pixel-9", DeviceName: "Pixel 9",
+		App: "Dinely", Agent: "Codex", Title: title, Detail: "Place the lunch order",
+		Created: now, Deadline: now.Add(time.Minute),
+	}
+}
+
+func TestSidebarNoticeExpandsAndInvokesPrimaryOnce(t *testing.T) {
+	n := sidebarNeedTest("need-one", "Pay $12.80?")
+	ta := shotApp(t, n)
+	recorder := &sidebarRecordingAPI{API: ta.app.api, calls: make(chan sidebarDecisionCall, 1)}
+	ta.app.api = recorder
+	ta.panelHost = &panelHost{}
+	tt := mg.NewTester(ta.panelView, panelHostW, panelNoticeHeight(n))
+	if !hasText(tt, "Pixel 9 · Dinely") || !hasText(tt, n.Title) {
+		t.Fatalf("notice omits live Need identity or title: %q", tt.Texts())
+	}
+	if err := tt.Click(n.ID + " " + n.Title); err != nil {
+		t.Fatal(err)
+	}
+	if ta.panelExpandedNeedID != n.ID {
+		t.Fatalf("body click expanded %q, want %q", ta.panelExpandedNeedID, n.ID)
+	}
+	_, expandedHeight := ta.panelSize()
+	tt = mg.NewTester(ta.panelView, panelHostW, expandedHeight)
+	if !hasText(tt, n.Detail) {
+		t.Fatalf("expanded panel omits Need details: %q", tt.Texts())
+	}
+	if err := tt.Click(locales.TasksDetails()); err != nil {
+		t.Fatal(err)
+	}
+	tt = mg.NewTester(ta.panelView, panelHostW, panelHostH)
+	if err := tt.Click(locales.NeedsAllow()); err != nil {
+		t.Fatal(err)
+	}
+	if len(ta.answered) != 1 || ta.answered[0].need.ID != n.ID || ta.answered[0].d != gateway.AllowOnce {
+		t.Fatalf("primary action did not answer the displayed Need once: %+v", ta.answered)
+	}
+	// This fixture verifies the UI-to-API contract, without claiming a real task completed.
+	select {
+	case call := <-recorder.calls:
+		if call.id != n.ID || call.decision != gateway.AllowOnce {
+			t.Fatalf("primary callback sent the wrong request or scope: %+v", call)
+		}
+	case <-time.After(time.Minute):
+		t.Fatal("primary callback did not reach the recording API")
+	}
+	if _, h := ta.panelSize(); h != panelHostH {
+		t.Fatalf("answer confirmation changed the compact strip height to %d", h)
+	}
+}
+
+func TestSidebarNoticeNewNeedResetsExpandedAndPressedAction(t *testing.T) {
+	first := sidebarNeedTest("need-one", "Pay $12.80?")
+	second := sidebarNeedTest("need-two", "Delete this draft?")
+	ta := shotApp(t, first)
+	ta.panelHost = &panelHost{}
+	tt := mg.NewTester(ta.panelView, panelHostW, panelNoticeHeight(first))
+	button, ok := tt.Find(locales.NeedsAllow())
+	if !ok {
+		t.Fatalf("allow button missing from notice: %q", tt.Texts())
+	}
+	x, y := button.X+button.W/2, button.Y+button.H/2
+	tt.Press(x, y)
+	ta.needs = []gateway.NeedView{second}
+	tt.Frame()
+	tt.Release(x, y)
+	if len(ta.answered) != 0 {
+		t.Fatalf("old pressed button answered a new Need: %+v", ta.answered)
+	}
+	if ta.panelExpandedNeedID != "" || ta.panelNeedID != second.ID {
+		t.Fatalf("new Need state was not reset: current=%q expanded=%q", ta.panelNeedID, ta.panelExpandedNeedID)
+	}
+	tt.Frame()
+	if !hasText(tt, second.Title) {
+		t.Fatalf("new Need was not shown in the notice state: %q", tt.Texts())
+	}
+}
+
+func TestSidebarPanelCornersStayTransparent(t *testing.T) {
+	for _, expanded := range []bool{false, true} {
+		n := sidebarNeedTest("corner-need", "Review this operation")
+		ta := shotApp(t, n)
+		ta.panelHost = &panelHost{}
+		if expanded {
+			ta.panelNeedExpanded(n.ID)
+			ta.panelExpandedNeedID = n.ID
+		}
+		width, height := ta.panelSize()
+		tt := mg.NewTester(ta.panelView, width, height)
+		img := tt.Image()
+		for _, point := range [][2]int{{0, 0}, {3, 3}, {width - 1, 0}, {width - 4, 3},
+			{0, height - 1}, {3, height - 4}, {width - 1, height - 1}, {width - 4, height - 4}} {
+			if alpha := img.RGBAAt(point[0], point[1]).A; alpha != 0 {
+				t.Fatalf("expanded=%v: outside corner %v contains a stray layer with alpha %d", expanded, point, alpha)
+			}
+		}
+	}
+	// GlassSurface.Paint uses this quiet edge on the adjacent sidebar cards.
+	edge := sidebarGlassEdge()
+	if edge.From != mg.RGBA(255, 255, 255, 88.0/255) || edge.To != mg.RGBA(255, 255, 255, 22.0/255) {
+		t.Fatal("notification edge diverged from the neighboring card edge")
+	}
+}
