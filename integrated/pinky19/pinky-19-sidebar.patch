+
+// The optional host transports layout metadata. Decisions remain in panelView.
+func (a *app) startPanelHost() {
+	directory := os.Getenv(panelHostEnvironment)
+	if directory == "" {
+		return
+	}
+	if err := validatePanelHostDirectory(directory); err != nil {
+		log.Printf("pinky: approval host directory unavailable: %v", err)
+		return
+	}
+	for _, proc := range []*windows.LazyProc{panelHostDPIContext, panelHostDPIEqual, panelHostGetDPI} {
+		if err := proc.Find(); err != nil {
+			log.Printf("pinky: approval host requires window DPI APIs: %v", err)
+			return
+		}
+	}
+	birth, err := panelHostBirth(os.Getpid())
+	if err != nil {
+		log.Printf("pinky: approval host process identity unavailable: %v", err)
+		return
+	}
+	a.panelHost = &panelHost{directory: filepath.Clean(directory), processBirth: birth}
+	go func() {
+		ticker := time.NewTicker(panelHostInterval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-a.ctx.Done():
+				return
+			case <-ticker.C:
+				mygo.RunOnMain(func() {
+					if a.ctx.Err() == nil {
+						a.syncPanel()
+					}
+				})
+			}
+		}
+	}()
+}
+
+func (a *app) stopPanelHost() {
+	if a.panelHost == nil {
+		return
+	}
+	a.restoreHostedPanel(false)
+	a.publishPanelHost("hidden", "")
+	a.panelHost = nil
+}
+
+func (a *app) panelHosted() bool {
+	return a.panelHost != nil && a.panelHost.attached
+}
+
+// The floating panel remains a top-level HWND with an optional native owner.
+func (a *app) panelHostOpaque() bool { return a.panelHost != nil }
+
+// MyGo's Panel flag requests DWM rounding even when CornerRadius is zero.
+// Only the glass painter should define the hosted panel's 24-DIP silhouette.
+func (a *app) configureSidebarPanelChrome() {
+	for _, attribute := range []struct{ id, value uint32 }{
+		{33, 1},          // DWMWA_WINDOW_CORNER_PREFERENCE, DWMWCP_DONOTROUND.
+		{34, 0xfffffffe}, // DWMWA_BORDER_COLOR, DWMWA_COLOR_NONE.
+	} {
+		result, _, _ := panelHostSetDWM.Call(a.panel.NativeHandle(), uintptr(attribute.id),
+			uintptr(unsafe.Pointer(&attribute.value)), unsafe.Sizeof(attribute.value))
+		if uint32(result) == 0x80070005 {
+			if a.panelHost != nil {
+				a.panelHost.recordError(windows.ERROR_ACCESS_DENIED)
+			}
+			return
+		}
+		if result != 0 && uint32(result) != 0x80070057 {
+			log.Printf("pinky: sidebar panel chrome attribute %d failed: 0x%x", attribute.id, uint32(result))
+		}
+	}
+}
+
+// A parent HWND can destroy its child without ending the Pinky coordinator.
+func (a *app) ensureHostedPanel() {
+	if a.panelHost == nil {
+		return
+	}
+	if a.finishSidebarDemo() {
+		return
+	}
+	if a.panel != nil && !a.panel.IsDestroyed() {
+		if ok, _, _ := panelHostIsWindow.Call(a.panel.NativeHandle()); ok != 0 {
+			return
+		}
+		// An external parent's exit can remove the HWND without reporting Closed.
+		a.panel.Destroy()
+	}
+	a.panelHost.attached = false
+	a.panelHost.parent = 0
+	a.newPanel()
+}
+
+func (a *app) syncHostedPanel(want bool) bool {
+	host := a.panelHost
+	if host == nil || host.blocked {
+		return false
+	}
+	if a.finishSidebarDemo() {
+		return true
+	}
+	now := time.Now()
+	spec, err := readPanelHost(host.directory, now)
+	if err != nil {
+		host.recordError(err)
+		a.restoreHostedPanel(want)
+		a.publishPanelHost(panelHostPhase(want), "host-unavailable")
+		return false
+	}
+	host.lease.observe(spec, now)
+	if !host.lease.valid(now) {
+		a.restoreHostedPanel(want)
+		a.publishPanelHost(panelHostPhase(want), "host-expired")
+		return false
+	}
+	spec = host.lease.spec
+	if host.attached {
+		owner, _, _ := panelHostGetWindow.Call(a.panel.NativeHandle(), panelHostOwnerWindow)
+		if owner != host.parent {
+			a.restoreHostedPanel(want)
+		}
+	}
+	if err := validatePanelHostWindow(spec, a.panel.NativeHandle()); err != nil {
+		if errors.Is(err, errPanelHostHidden) && host.attached && host.parent == uintptr(spec.HWND) {
+			// The owner can minimize before its next visibility heartbeat arrives.
+			a.panel.Hide()
+			a.publishPanelHost("requested", "")
+			return true
+		}
+		if errors.Is(err, errPanelHostLayout) && host.attached && host.parent == uintptr(spec.HWND) {
+			if host.layoutWait.IsZero() {
+				host.layoutWait = now
+			}
+			if now.Sub(host.layoutWait) < panelHostLeaseDuration {
+				a.publishPanelHost("requested", "host-layout-pending")
+				return true
+			}
+		}
+		host.recordError(err)
+		a.restoreHostedPanel(want)
+		a.publishPanelHost(panelHostPhase(want), "host-window-invalid")
+		return false
+	}
+	host.layoutWait = time.Time{}
+	if host.nonce != spec.Nonce {
+		a.restoreHostedPanel(want)
+		host.nonce, host.sequence = spec.Nonce, 0
+	}
+	if !want {
+		a.restoreHostedPanel(false)
+		a.publishPanelHost("hidden", "")
+		return false
+	}
+	if !spec.Visible {
+		// A live host controls visibility while the original need stays pending.
+		a.panel.Hide()
+		a.publishPanelHost("requested", "")
+		return true
+	}
+	a.panelMax = 0
+	width, height := a.panelSize()
+	widthPX, heightPX := (width*spec.DPI+95)/96, (height*spec.DPI+95)/96
+	// The sidebar supplies the available viewport. Expanded content can scroll.
+	widthPX = min(widthPX, int(spec.ClientRectPhysical.Width))
+	heightPX = min(heightPX, int(spec.ClientRectPhysical.Height))
+	if !host.attached {
+		if err := a.attachHostedPanel(spec, widthPX, heightPX); err != nil {
+			host.recordError(err)
+			a.restoreHostedPanel(true)
+			a.publishPanelHost("standalone", "attach-failed")
+			return false
+		}
+	} else if host.width != widthPX || host.height != heightPX || host.x != spec.ClientRectPhysical.X || host.y != spec.ClientRectPhysical.Y {
+		if err := positionHostedPanel(a.panel.NativeHandle(), spec.ClientRectPhysical, widthPX, heightPX); err != nil {
+			host.recordError(err)
+			a.restoreHostedPanel(true)
+			a.publishPanelHost("standalone", "resize-failed")
+			return false
+		}
+		host.width, host.height = widthPX, heightPX
+		host.x, host.y = spec.ClientRectPhysical.X, spec.ClientRectPhysical.Y
+	}
+	if !a.panel.IsVisible() {
+		a.panel.ShowInactive()
+	}
+	if err := a.publishPanelHost("attached", ""); err != nil {
+		host.recordError(err)
+		a.restoreHostedPanel(true)
+		return false
+	}
+	return true
+}
+
+// An access denial ends this opt-in connection until the app is restarted.
+func (h *panelHost) recordError(err error) {
+	if errors.Is(err, os.ErrPermission) || errors.Is(err, windows.ERROR_ACCESS_DENIED) {
+		if !h.blocked {
+			log.Printf("pinky: approval host disabled after access denial: %v", err)
+		}
+		h.blocked = true
+	}
+}
+
+func panelHostPhase(want bool) string {
+	if want {
+		return "standalone"
+	}
+	return "hidden"
+}
+
+func (a *app) attachHostedPanel(spec panelHostSpec, width, height int) error {
+	host := a.panelHost
+	parent := uintptr(spec.HWND)
+	window := a.panel.NativeHandle()
+	host.style, _, _ = panelHostGetLong.Call(window, panelHostStyleIndex)
+	host.exStyle, _, _ = panelHostGetLong.Call(window, panelHostExStyleIndex)
+	host.owner, _, _ = panelHostGetLong.Call(window, panelHostOwnerIndex)
+	if host.style&panelHostChildStyle != 0 {
+		return errors.New("the approval popup must remain a top-level window")
+	}
+	a.panel.Hide()
+	host.attached, host.parent = true, parent
+	host.seenParent = parent
+	// Ownership preserves the transparent composition surface and its own input.
+	if err := setPanelHostLong(window, panelHostOwnerIndex, parent); err != nil {
+		return err
+	}
+	if err := positionHostedPanel(window, spec.ClientRectPhysical, width, height); err != nil {
+		return err
+	}
+	a.panel.ShowInactive()
+	hostContext, _, _ := panelHostDPIContext.Call(parent)
+	panelContext, _, _ := panelHostDPIContext.Call(window)
+	hostDPI, _, _ := panelHostGetDPI.Call(parent)
+	panelDPI, _, _ := panelHostGetDPI.Call(window)
+	if equal, _, _ := panelHostDPIEqual.Call(hostContext, panelContext); equal == 0 || hostDPI == 0 || panelDPI != hostDPI {
+		return errors.New("panel DPI changed during attachment")
+	}
+	host.width, host.height = width, height
+	host.x, host.y = spec.ClientRectPhysical.X, spec.ClientRectPhysical.Y
+	return nil
+}
+
+// The isolated demo belongs to its preview and ends with that preview.
+func (a *app) finishSidebarDemo() bool {
+	host := a.panelHost
+	if a.opt.Version != "0.0.0-demo" || os.Getenv("PINKY_DEMO_EXIT_WITH_HOST") != "1" || host == nil || host.seenParent == 0 {
+		return false
+	}
+	if exists, _, _ := panelHostIsWindow.Call(host.seenParent); exists != 0 {
+		return false
+	}
+	if a.panel != nil && !a.panel.IsDestroyed() {
+		a.panel.Hide()
+	}
+	mygo.App.Quit()
+	return true
+}
+
+func (a *app) restoreHostedPanel(show bool) {
+	host := a.panelHost
+	if host == nil || !host.attached {
+		return
+	}
+	host.attached, host.parent = false, 0
+	if a.panel == nil || a.panel.IsDestroyed() {
+		a.newPanel()
+	} else {
+		window := a.panel.NativeHandle()
+		if ok, _, _ := panelHostIsWindow.Call(window); ok == 0 {
+			a.panel.Destroy()
+			a.newPanel()
+		} else {
+			a.panel.Hide()
+			err := setPanelHostLong(window, panelHostOwnerIndex, host.owner)
+			if err == nil {
+				err = setPanelHostLong(window, panelHostStyleIndex, host.style)
+			}
+			if err == nil {
+				err = setPanelHostLong(window, panelHostExStyleIndex, host.exStyle)
+			}
+			if err == nil {
+				band := panelHostNotTopmost
+				if host.exStyle&panelHostTopmostStyle != 0 {
+					band = panelHostTopmost
+				}
+				if ok, _, callErr := panelHostSetPosition.Call(window, band, 0, 0, 0, 0, panelHostNoMove|panelHostNoSize|panelHostNoActivate|panelHostFrameChanged); ok == 0 {
+					err = callErr
+				}
+			}
+			if err != nil {
+				// Close the detached, unusable surface and rebuild from current needs.
+				a.panel.Destroy()
+				a.newPanel()
+			}
+		}
+	}
+	a.placePanel()
+	a.fitPanel()
+	if show {
+		a.panel.ShowInactive()
+	} else {
+		a.closeShot()
+	}
+}
+
+func setPanelHostLong(window, index, value uintptr) error {
+	panelHostClearError.Call(0)
+	previous, _, err := panelHostSetLong.Call(window, index, value)
+	if previous == 0 && err != windows.ERROR_SUCCESS {
+		return err
+	}
+	return nil
+}
+
+func positionHostedPanel(window uintptr, anchor panelHostRect, width, height int) error {
+	ok, _, err := panelHostSetPosition.Call(window, panelHostTopmost, uintptr(int64(anchor.X)), uintptr(int64(anchor.Y)), uintptr(width), uintptr(height), panelHostNoActivate)
+	if ok == 0 {
+		return err
+	}
+	return nil
+}
+
+func validatePanelHostWindow(spec panelHostSpec, panel uintptr) error {
+	window := uintptr(spec.HWND)
+	if window == panel || spec.PID == os.Getpid() {
+		return errors.New("host must be a separate process")
+	}
+	if ok, _, _ := panelHostIsWindow.Call(window); ok == 0 {
+		return errors.New("host window is unavailable")
+	}
+	var pid uint32
+	panelHostWindowPID.Call(window, uintptr(unsafe.Pointer(&pid)))
+	if pid != uint32(spec.PID) {
+		return errors.New("host process does not match its window")
+	}
+	birth, err := panelHostBirth(spec.PID)
+	if err != nil {
+		return fmt.Errorf("read host process creation time: %w", err)
+	}
+	if birth != spec.ProcessBirthFileTime {
+		return errors.New("host process creation time does not match")
+	}
+	if spec.Visible {
+		if visible, _, _ := panelHostIsVisible.Call(window); visible == 0 {
+			return errPanelHostHidden
+		}
+	}
+	dpi, _, _ := panelHostGetDPI.Call(window)
+	hostContext, _, _ := panelHostDPIContext.Call(window)
+	panelContext, _, _ := panelHostDPIContext.Call(panel)
+	equal, _, _ := panelHostDPIEqual.Call(hostContext, panelContext)
+	if dpi != uintptr(spec.DPI) || hostContext == 0 || panelContext == 0 || equal == 0 {
+		return errors.New("host DPI does not match")
+	}
+	var rect struct{ Left, Top, Right, Bottom int32 }
+	var point struct{ X, Y int32 }
+	if ok, _, err := panelHostGetRect.Call(window, uintptr(unsafe.Pointer(&rect))); ok == 0 {
+		return fmt.Errorf("read host client rectangle: %w", err)
+	}
+	if ok, _, err := panelHostToScreen.Call(window, uintptr(unsafe.Pointer(&point))); ok == 0 {
+		return fmt.Errorf("read host screen position: %w", err)
+	}
+	expected := spec.ClientRectPhysical
+	if point.X != expected.X || point.Y != expected.Y || int64(rect.Right)-int64(rect.Left) != int64(expected.Width) || int64(rect.Bottom)-int64(rect.Top) != int64(expected.Height) {
+		return errPanelHostLayout
+	}
+	return nil
+}
+
+func panelHostBirth(pid int) (uint64, error) {
+	process, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION, false, uint32(pid))
+	if err != nil {
+		return 0, err
+	}
+	defer windows.CloseHandle(process)
+	var created, exited, kernel, user windows.Filetime
+	if err := windows.GetProcessTimes(process, &created, &exited, &kernel, &user); err != nil {
+		return 0, err
+	}
+	return uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime), nil
+}
+
+func validatePanelHostDirectory(directory string) error {
+	if !filepath.IsAbs(directory) {
+		return errors.New("host directory must be absolute")
+	}
+	volume, err := windows.UTF16PtrFromString(filepath.VolumeName(directory) + string(filepath.Separator))
+	if err != nil {
+		return err
+	}
+	if kind, _, _ := panelHostDriveType.Call(uintptr(unsafe.Pointer(volume))); kind != windows.DRIVE_FIXED {
+		return errors.New("host directory must be on a local fixed drive")
+	}
+	local, err := windows.KnownFolderPath(windows.FOLDERID_LocalAppData, 0)
+	if err != nil {
+		return err
+	}
+	relative, err := filepath.Rel(local, directory)
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) || filepath.IsAbs(relative) {
+		return errors.New("host directory must be in the current user's local data directory")
+	}
+	return panelHostNoReparse(directory)
+}
+
+func panelHostNoReparse(path string) error {
+	for current := filepath.Clean(path); ; current = filepath.Dir(current) {
+		name, err := windows.UTF16PtrFromString(current)
+		if err != nil {
+			return err
+		}
+		attributes, err := windows.GetFileAttributes(name)
+		if err != nil && !os.IsNotExist(err) {
+			return err
+		}
+		if err == nil && attributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+			return errors.New("host path contains a reparse point")
+		}
+		if parent := filepath.Dir(current); parent == current {
+			return nil
+		}
+	}
+}
+
+func readPanelHost(directory string, now time.Time) (panelHostSpec, error) {
+	if err := validatePanelHostDirectory(directory); err != nil {
+		return panelHostSpec{}, err
+	}
+	path := filepath.Join(directory, "host.json")
+	if err := panelHostNoReparse(path); err != nil {
+		return panelHostSpec{}, err
+	}
+	file, err := openPanelHostFile(path)
+	if err != nil {
+		return panelHostSpec{}, err
+	}
+	defer file.Close()
+	data, err := io.ReadAll(io.LimitReader(file, panelHostMaxBytes+1))
+	if err != nil {
+		return panelHostSpec{}, err
+	}
+	return parsePanelHost(data, now)
+}
+
+func readSidebarAppearanceFile(path string, maximum int64) ([]byte, error) {
+	if err := validatePanelHostDirectory(filepath.Dir(path)); err != nil {
+		return nil, err
+	}
+	if err := panelHostNoReparse(path); err != nil {
+		return nil, err
+	}
+	file, err := openPanelHostFile(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	data, err := io.ReadAll(io.LimitReader(file, maximum+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(data)) > maximum {
+		return nil, errors.New("appearance file exceeds its size limit")
+	}
+	return data, nil
+}
+
+// Readers keep atomic replacement available while they hold the old snapshot.
+func openPanelHostFile(path string) (*os.File, error) {
+	name, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return nil, err
+	}
+	handle, err := windows.CreateFile(name, windows.GENERIC_READ, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, windows.OPEN_EXISTING, windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+	if err != nil {
+		return nil, err
+	}
+	var info windows.ByHandleFileInformation
+	if err := windows.GetFileInformationByHandle(handle, &info); err != nil {
+		windows.CloseHandle(handle)
+		return nil, err
+	}
+	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+		windows.CloseHandle(handle)
+		return nil, errors.New("host file is a reparse point")
+	}
+	return os.NewFile(uintptr(handle), path), nil
+}
+
+func (a *app) publishPanelHost(phase, reason string) error {
+	host := a.panelHost
+	if host == nil || host.blocked || host.nonce == "" {
+		return nil
+	}
+	if err := validatePanelHostDirectory(host.directory); err != nil {
+		host.recordError(err)
+		return err
+	}
+	host.sequence++
+	width, height := a.panelSize()
+	state := panelHostPublication{
+		Schema: "pinky.sidebar-panel.v1", Nonce: host.nonce, Sequence: host.sequence,
+		PID: os.Getpid(), ProcessBirthFileTime: strconv.FormatUint(host.processBirth, 10),
+		UpdatedUTC: time.Now().UTC().Format(time.RFC3339Nano), Phase: phase,
+		DesiredWidthDIP: width, DesiredHeightDIP: height, Reason: reason,
+	}
+	if a.panel != nil && !a.panel.IsDestroyed() {
+		state.PanelHWND = fmt.Sprintf("0x%x", a.panel.NativeHandle())
+	}
+	data, err := json.Marshal(state)
+	if err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(host.directory, ".panel-*.tmp")
+	if err != nil {
+		host.recordError(err)
+		return err
+	}
+	name := file.Name()
+	defer os.Remove(name)
+	if _, err := file.Write(data); err != nil {
+		file.Close()
+		host.recordError(err)
+		return err
+	}
+	if err := file.Close(); err != nil {
+		host.recordError(err)
+		return err
+	}
+	err = replacePanelHostFile(name, filepath.Join(host.directory, "panel.json"))
+	host.recordError(err)
+	return err
+}
+
+func replacePanelHostFile(source, destination string) error {
+	if err := panelHostNoReparse(destination); err != nil {
+		return err
+	}
+	from, err := windows.UTF16PtrFromString(source)
+	if err != nil {
+		return err
+	}
+	to, err := windows.UTF16PtrFromString(destination)
+	if err != nil {
+		return err
+	}
+	if _, err := os.Lstat(destination); os.IsNotExist(err) {
+		return windows.MoveFileEx(from, to, windows.MOVEFILE_WRITE_THROUGH)
+	} else if err != nil {
+		return err
+	}
+	ok, _, err := panelHostReplaceFile.Call(uintptr(unsafe.Pointer(to)), uintptr(unsafe.Pointer(from)), 0, 0, 0, 0)
+	if ok == 0 {
+		return &os.LinkError{Op: "replace", Old: source, New: destination, Err: err}
+	}
+	return nil
+}
