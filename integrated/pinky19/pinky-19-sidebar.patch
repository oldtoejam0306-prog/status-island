+
+func panelDeadlineText(n gateway.NeedView) string {
+	left := time.Until(n.Deadline)
+	secs := time.Duration(math.Ceil(max(0, left.Seconds()))) * time.Second
+	if n.Kind == gateway.NeedHandoff {
+		return locales.PanelEndsIn(elapsed(secs))
+	}
+	return locales.PanelDeniesIn(elapsed(secs))
+}
+
+func panelTimeRemaining(n gateway.NeedView) string {
+	left := time.Until(n.Deadline)
+	secs := time.Duration(math.Ceil(max(0, left.Seconds()))) * time.Second
+	minutes := int(secs / time.Minute)
+	seconds := int(secs/time.Second) % 60
+	return fmt.Sprintf("%02d:%02d", minutes, seconds)
+}
+
+func sidebarGlassEdge() mg.LinearGradient {
+	// Match GlassSurface.Paint, which draws the neighboring sidebar cards.
+	return mg.LinearGradient{
+		From: mg.RGBA(255, 255, 255, 88.0/255), To: mg.RGBA(255, 255, 255, 22.0/255), Angle: 180,
+	}
+}
+
+func sidebarPrimaryLabel(n gateway.NeedView) string {
+	switch {
+	case n.Kind == gateway.NeedHandoff:
+		return locales.NeedsDone()
+	case n.Unblock:
+		return locales.NeedsAllowTask()
+	default:
+		return locales.NeedsAllow()
+	}
+}
+
+func sidebarAnswerStatus(x answer) string {
+	switch {
+	case x.need.Kind == gateway.NeedHandoff && x.d == gateway.AllowOnce:
+		return locales.PanelHandedBack()
+	case x.need.Kind == gateway.NeedHandoff:
+		return locales.PanelDeclined()
+	case newAgentNeed(x.need) && x.d == gateway.Deny:
+		return locales.PanelDenied()
+	case newAgentNeed(x.need):
+		return locales.PanelAllowed()
+	case x.need.Unblock && x.d != gateway.Deny:
+		return locales.PanelAllowedTask()
+	case x.d == gateway.AllowOnce:
+		return locales.PanelAllowedOnce()
+	case x.d == gateway.AllowTask:
+		return locales.PanelAllowedTask()
+	case x.d == gateway.AllowAlways:
+		return locales.PanelAlwaysAllowed()
+	default:
+		return locales.PanelDenied()
+	}
+}
+
+func (a *app) sidebarPrimary(n gateway.NeedView) {
+	switch {
+	case n.Kind == gateway.NeedHandoff:
+		a.completeHandoff(n)
+	case n.Unblock:
+		a.decide(n, gateway.AllowTask, "")
+	default:
+		a.decide(n, gateway.AllowOnce, "")
+	}
+}
+
+func (a *app) completeHandoff(n gateway.NeedView) {
+	// Match handoffControls: Done answers once with its current note.
+	a.decide(n, gateway.AllowOnce, strings.TrimSpace(a.notes[n.ID]))
+}
