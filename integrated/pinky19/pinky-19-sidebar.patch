+							mg.Text(c, locales.NeedsSubmitting()).FontSize(12).TextColor(p.ink2).SingleLine()
+						} else if reply != nil && reply.message != "" {
+							mg.Text(c, reply.message).FontSize(12).TextColor(p.red).SingleLine().Tooltip(reply.message)
+						} else if !n.Deadline.IsZero() {
+							mg.Text(c, panelTimeRemaining(n)).FontSize(12).FontWeight(600).TextColor(p.accentInk).Tooltip(panelDeadlineText(n)).SingleLine()
