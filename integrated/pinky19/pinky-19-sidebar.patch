new file mode 100644
index 0000000..291d0d8
--- /dev/null
+++ b/ui/panel_host_windows_test.go
@@ -0,0 +1,58 @@
+package ui
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestPanelHostReaderAllowsAtomicReplacement(t *testing.T) {
+	directory := t.TempDir()
+	path := filepath.Join(directory, "host.json")
+	if err := os.WriteFile(path, []byte("old snapshot"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	reader, err := openPanelHostFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	replacement := filepath.Join(directory, "next.tmp")
+	if err := os.WriteFile(replacement, []byte("next snapshot"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := replacePanelHostFile(replacement, path); err != nil {
+		t.Fatalf("an open metadata reader blocked atomic replacement: %v", err)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil || string(data) != "next snapshot" {
+		t.Fatalf("replacement was not published: %q, %v", data, err)
+	}
+}
+
+func TestPanelHostAccessDenialStopsConnection(t *testing.T) {
+	for _, denied := range []error{os.ErrPermission, windows.ERROR_ACCESS_DENIED, fmt.Errorf("identity check: %w", windows.ERROR_ACCESS_DENIED)} {
+		host := &panelHost{}
+		host.recordError(denied)
+		if !host.blocked {
+			t.Fatalf("access denial did not stop the connection: %v", denied)
+		}
+		host.recordError(nil)
+		if !host.blocked {
+			t.Fatal("a later successful operation cleared the access-denial latch")
+		}
+	}
+}
+
+func TestPanelHostTransientErrorsDoNotStopConnection(t *testing.T) {
+	host := &panelHost{}
+	for _, err := range []error{nil, os.ErrNotExist, windows.ERROR_SHARING_VIOLATION} {
+		host.recordError(err)
+		if host.blocked {
+			t.Fatalf("transient error stopped the connection: %v", err)
+		}
+	}
+}
